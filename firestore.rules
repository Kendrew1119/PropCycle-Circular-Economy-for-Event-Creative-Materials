rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function boundedString(value, minimum, maximum) {
      return value is string
          && value.size() >= minimum
          && value.size() <= maximum;
    }

    function safeSegment(value) {
      return boundedString(value, 1, 128)
          && value.matches('^[A-Za-z0-9_-]+$');
    }

    function validProfile() {
      return request.resource.data.keys().hasAll([
            'displayName', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'displayName', 'createdAt', 'updatedAt'
          ])
          && boundedString(request.resource.data.displayName, 1, 80)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
    }

    function validCategory(category) {
      return category in [
        'banner', 'decoration', 'fabric', 'stationery', 'craft', 'cosplay',
        'toys', 'wood', 'electronic', 'packaging', 'other'
      ];
    }

    function validCondition(condition) {
      return condition in ['new', 'like_new', 'good', 'fair', 'poor'];
    }

    function validTransaction(data) {
      return data.transactionIntent in ['sale', 'donation', 'exchange']
          && data.priceMinor is int
          && data.priceMinor >= 0
          && data.priceMinor <= 100000000
          && data.exchangeTerms is string
          && data.exchangeTerms.size() <= 500
          && (
            (data.transactionIntent == 'sale'
                && data.priceMinor > 0
                && data.exchangeTerms == '')
            || (data.transactionIntent == 'donation'
                && data.priceMinor == 0
                && data.exchangeTerms == '')
            || (data.transactionIntent == 'exchange'
                && data.priceMinor == 0
                && data.exchangeTerms.size() > 0)
          );
    }

    function validListingImageUrl(imageUrl, ownerId, listingId) {
      return imageUrl == null
          || (imageUrl is string
              && imageUrl.size() <= 512
              && imageUrl.matches(
                  '^gs://[A-Za-z0-9._-]+/marketplace/'
                  + ownerId + '/' + listingId
                  + '/primary_[A-Za-z0-9_-]+[.]jpg$'));
    }

    function validListing(listingId) {
      return request.resource.data.keys().hasAll([
            'ownerId', 'title', 'titleNormalized', 'description', 'category',
            'condition', 'transactionIntent', 'fulfilmentMethod', 'priceMinor',
            'exchangeTerms', 'imageUrl', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'ownerId', 'title', 'titleNormalized', 'description', 'category',
            'condition', 'transactionIntent', 'fulfilmentMethod', 'priceMinor',
            'exchangeTerms', 'imageUrl', 'status', 'createdAt', 'updatedAt'
          ])
          && safeSegment(request.resource.data.ownerId)
          && safeSegment(listingId)
          && boundedString(request.resource.data.title, 3, 100)
          && boundedString(request.resource.data.titleNormalized, 3, 100)
          && boundedString(request.resource.data.description, 1, 1000)
          && validCategory(request.resource.data.category)
          && validCondition(request.resource.data.condition)
          && validTransaction(request.resource.data)
          && request.resource.data.fulfilmentMethod in ['pickup', 'meetup']
          && validListingImageUrl(
              request.resource.data.imageUrl,
              request.resource.data.ownerId,
              listingId)
          && request.resource.data.status in ['available', 'withdrawn']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
    }

    function listing(listingId) {
      return get(/databases/$(database)/documents/marketplaceListings/$(listingId)).data;
    }

    function lendingItem(itemId) {
      return get(/databases/$(database)/documents/lendingItems/$(itemId)).data;
    }

    function validLendingImageUrl(imageUrl, ownerId, itemId) {
      return imageUrl == null
          || (imageUrl is string
              && imageUrl.size() <= 512
              && imageUrl.matches(
                  '^gs://[A-Za-z0-9._-]+/lending/'
                  + ownerId + '/' + itemId
                  + '/primary_[A-Za-z0-9_-]+[.]jpg$'));
    }

    function validApproximateLocation(data) {
      return (data.latitude == null && data.longitude == null)
          || (data.latitude is number
              && data.longitude is number
              && data.latitude >= -90
              && data.latitude <= 90
              && data.longitude >= -180
              && data.longitude <= 180);
    }

    function validLendingItem(itemId) {
      let data = request.resource.data;
      return data.keys().hasAll([
            'ownerId', 'title', 'titleNormalized', 'description', 'category',
            'condition', 'pickupMethod', 'areaLabel', 'maxBorrowDays',
            'depositMinor', 'latitude', 'longitude', 'imageUrl', 'status',
            'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'ownerId', 'title', 'titleNormalized', 'description', 'category',
            'condition', 'pickupMethod', 'areaLabel', 'maxBorrowDays',
            'depositMinor', 'latitude', 'longitude', 'imageUrl', 'status',
            'createdAt', 'updatedAt'
          ])
          && safeSegment(data.ownerId)
          && safeSegment(itemId)
          && boundedString(data.title, 3, 100)
          && boundedString(data.titleNormalized, 3, 100)
          && boundedString(data.description, 1, 1000)
          && data.category in [
            'equipment', 'tools', 'electronics', 'event_gear', 'craft', 'other'
          ]
          && data.condition in ['new', 'like_new', 'good', 'fair']
          && data.pickupMethod in ['pickup', 'meetup']
          && boundedString(data.areaLabel, 2, 100)
          && data.maxBorrowDays is int
          && data.maxBorrowDays >= 1
          && data.maxBorrowDays <= 31
          && data.depositMinor is int
          && data.depositMinor >= 0
          && data.depositMinor <= 10000000
          && validApproximateLocation(data)
          && validLendingImageUrl(data.imageUrl, data.ownerId, itemId)
          && data.status in ['available', 'withdrawn']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function validLendingRequest(requestId) {
      let data = request.resource.data;
      let source = lendingItem(data.itemId);
      return safeSegment(requestId)
          && data.keys().hasAll([
            'itemId', 'itemTitle', 'ownerUid', 'borrowerUid', 'participantIds',
            'startDate', 'endDate', 'dayKeys', 'status', 'lockToken',
            'returnReported', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'itemId', 'itemTitle', 'ownerUid', 'borrowerUid', 'participantIds',
            'startDate', 'endDate', 'dayKeys', 'status', 'lockToken',
            'returnReported', 'createdAt', 'updatedAt'
          ])
          && safeSegment(data.itemId)
          && boundedString(data.itemTitle, 3, 100)
          && safeSegment(data.ownerUid)
          && safeSegment(data.borrowerUid)
          && data.ownerUid != data.borrowerUid
          && data.participantIds == [data.ownerUid, data.borrowerUid]
          && data.startDate is string
          && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.endDate is string
          && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.dayKeys is list
          && data.dayKeys.size() >= 1
          && data.dayKeys.size() <= 31
          && data.dayKeys.size() <= source.maxBorrowDays
          && data.startDate == data.dayKeys[0]
          && data.endDate == data.dayKeys[data.dayKeys.size() - 1]
          && data.status == 'pending'
          && data.lockToken == ''
          && data.returnReported == false
          && source.ownerId == data.ownerUid
          && source.title == data.itemTitle
          && source.status == 'available'
          && data.createdAt == request.time
          && data.updatedAt == request.time;
    }

    function validApprovalBoundaryLocks(requestId) {
      let first = getAfter(
          /databases/$(database)/documents/lendingItems/$(resource.data.itemId)/bookedDays/$(resource.data.startDate)).data;
      let last = getAfter(
          /databases/$(database)/documents/lendingItems/$(resource.data.itemId)/bookedDays/$(resource.data.endDate)).data;
      return first.requestId == requestId
          && last.requestId == requestId
          && first.lockToken == request.resource.data.lockToken
          && last.lockToken == request.resource.data.lockToken;
    }

    function releasedApprovalBoundaryLocks() {
      return !existsAfter(
            /databases/$(database)/documents/lendingItems/$(resource.data.itemId)/bookedDays/$(resource.data.startDate))
          && !existsAfter(
            /databases/$(database)/documents/lendingItems/$(resource.data.itemId)/bookedDays/$(resource.data.endDate));
    }

    function validLendingRequestTransition(requestId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.status;
      let nextStatus = request.resource.data.status;
      let owner = resource.data.ownerUid == currentUid();
      let borrower = resource.data.borrowerUid == currentUid();
      return request.resource.data.updatedAt == request.time
          && (
            (owner && oldStatus == 'pending' && nextStatus == 'approved'
              && changed.hasOnly(['status', 'lockToken', 'updatedAt'])
              && boundedString(request.resource.data.lockToken, 20, 80)
              && validApprovalBoundaryLocks(requestId))
            || (owner && oldStatus == 'pending' && nextStatus == 'rejected'
              && changed.hasOnly(['status', 'updatedAt']))
            || (owner && oldStatus == 'approved' && nextStatus == 'active'
              && changed.hasOnly(['status', 'updatedAt']))
            || (borrower && oldStatus == 'active' && nextStatus == 'active'
              && resource.data.returnReported == false
              && request.resource.data.returnReported == true
              && changed.hasOnly(['returnReported', 'updatedAt']))
            || (owner && oldStatus == 'active' && nextStatus == 'returned'
              && resource.data.returnReported == true
              && changed.hasOnly(['status', 'updatedAt']))
            || (borrower && oldStatus in ['pending', 'approved']
              && nextStatus == 'cancelled'
              && changed.hasOnly(['status', 'updatedAt'])
              && (oldStatus == 'pending' || releasedApprovalBoundaryLocks()))
            || (borrower && oldStatus == 'returned' && nextStatus == 'rated'
              && changed.hasOnly(['status', 'updatedAt'])
              && existsAfter(/databases/$(database)/documents/lendingRatings/$(requestId + '_' + currentUid())))
          );
    }

    function validNewLendingThread(data, threadId) {
      let source = lendingItem(data.contextId);
      return data.contextType == 'lending'
          && threadId == 'lending_' + data.contextId + '_'
              + data.ownerUid + '_' + data.contactUid
          && source.ownerId == data.ownerUid
          && source.title == data.contextTitle
          && source.status == 'available';
    }

    function validNewMarketplaceThread(data, threadId) {
      let source = listing(data.contextId);
      return data.contextType == 'marketplace'
          && threadId == 'marketplace_' + data.contextId + '_'
              + data.ownerUid + '_' + data.contactUid
          && source.ownerId == data.ownerUid
          && source.title == data.contextTitle
          && source.status == 'available';
    }

    function validNewThread(threadId) {
      let data = request.resource.data;
      return data.keys().hasAll([
            'contextType', 'contextId', 'contextTitle', 'ownerUid', 'contactUid',
            'participantIds', 'lastMessageId', 'lastMessageText',
            'lastMessageSenderId', 'lastMessageAt', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'contextType', 'contextId', 'contextTitle', 'ownerUid', 'contactUid',
            'participantIds', 'lastMessageId', 'lastMessageText',
            'lastMessageSenderId', 'lastMessageAt', 'createdAt', 'updatedAt'
          ])
          && data.contextType in ['marketplace', 'lending']
          && boundedString(data.contextId, 1, 128)
          && boundedString(data.contextTitle, 1, 120)
          && boundedString(data.ownerUid, 1, 128)
          && boundedString(data.contactUid, 1, 128)
          && data.ownerUid != data.contactUid
          && data.contactUid == currentUid()
          && data.participantIds == [data.ownerUid, data.contactUid]
          && (validNewMarketplaceThread(data, threadId)
              || validNewLendingThread(data, threadId))
          && data.lastMessageId == ''
          && data.lastMessageText == ''
          && data.lastMessageSenderId == ''
          && data.lastMessageAt == request.time
          && data.createdAt == request.time
          && data.updatedAt == request.time;
    }

    function isThreadParticipant(threadId) {
      let thread = get(
          /databases/$(database)/documents/chatThreads/$(threadId)).data;
      return signedIn() && currentUid() in thread.participantIds;
    }

    function validThreadMessageUpdate(threadId) {
      let data = request.resource.data;
      let message = getAfter(
          /databases/$(database)/documents/chatThreads/$(threadId)/messages/$(data.lastMessageId)).data;
      return currentUid() in resource.data.participantIds
          && data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessageId', 'lastMessageText', 'lastMessageSenderId',
            'lastMessageAt', 'updatedAt'
          ])
          && boundedString(data.lastMessageId, 20, 80)
          && boundedString(data.lastMessageText, 1, 2000)
          && data.lastMessageSenderId == currentUid()
          && data.lastMessageAt == request.time
          && data.updatedAt == request.time
          && message.clientOperationId == data.lastMessageId
          && message.senderId == data.lastMessageSenderId
          && message.text == data.lastMessageText
          && message.sentAt == data.lastMessageAt;
    }

    function validNewMessage(threadId, messageId) {
      let data = request.resource.data;
      let threadAfter = getAfter(
          /databases/$(database)/documents/chatThreads/$(threadId)).data;
      return data.keys().hasAll([
            'senderId', 'text', 'clientOperationId', 'sentAt'
          ])
          && data.keys().hasOnly([
            'senderId', 'text', 'clientOperationId', 'sentAt'
          ])
          && data.senderId == currentUid()
          && boundedString(data.text, 1, 2000)
          && data.text.matches('.*\\S.*')
          && boundedString(data.clientOperationId, 20, 80)
          && data.clientOperationId == messageId
          && data.sentAt == request.time
          && threadAfter.lastMessageId == messageId
          && threadAfter.lastMessageText == data.text
          && threadAfter.lastMessageSenderId == data.senderId
          && threadAfter.lastMessageAt == data.sentAt
          && threadAfter.updatedAt == data.sentAt;
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
          && currentUid() == uid
          && validProfile()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
          && currentUid() == uid
          && validProfile()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /marketplaceListings/{listingId} {
      allow get: if signedIn()
          && (resource.data.status == 'available'
              || resource.data.ownerId == currentUid());
      allow list: if signedIn()
          && request.query.limit != null
          && request.query.limit <= 50
          && resource.data.status == 'available';
      allow create: if signedIn()
          && request.resource.data.ownerId == currentUid()
          && exists(/databases/$(database)/documents/users/$(currentUid()))
          && validListing(listingId)
          && request.resource.data.status == 'available'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
          && resource.data.ownerId == currentUid()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'titleNormalized', 'description', 'category', 'condition',
            'transactionIntent', 'fulfilmentMethod', 'priceMinor',
            'exchangeTerms', 'imageUrl', 'status', 'updatedAt'
          ])
          && validListing(listingId);
      allow delete: if false;
    }

    match /lendingItems/{itemId} {
      allow get: if signedIn()
          && (resource.data.status == 'available'
              || resource.data.ownerId == currentUid());
      allow list: if signedIn()
          && request.query.limit != null
          && request.query.limit <= 50
          && resource.data.status == 'available';
      allow create: if signedIn()
          && request.resource.data.ownerId == currentUid()
          && exists(/databases/$(database)/documents/users/$(currentUid()))
          && validLendingItem(itemId)
          && request.resource.data.status == 'available'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
          && resource.data.ownerId == currentUid()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'titleNormalized', 'description', 'category', 'condition',
            'pickupMethod', 'areaLabel', 'maxBorrowDays', 'depositMinor',
            'latitude', 'longitude', 'imageUrl', 'status', 'updatedAt'
          ])
          && validLendingItem(itemId);
      allow delete: if false;

      match /bookedDays/{dateKey} {
        allow get: if signedIn()
            && (lendingItem(itemId).ownerId == currentUid()
                || currentUid() in get(
                  /databases/$(database)/documents/lendingRequests/$(resource.data.requestId)).data.participantIds);
        allow list: if false;
        allow create: if signedIn()
            && lendingItem(itemId).ownerId == currentUid()
            && request.resource.data.keys().hasAll([
              'requestId', 'lockToken', 'date', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'requestId', 'lockToken', 'date', 'updatedAt'
            ])
            && safeSegment(request.resource.data.requestId)
            && boundedString(request.resource.data.lockToken, 20, 80)
            && request.resource.data.date == dateKey
            && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/lendingRequests/$(request.resource.data.requestId)).data.status == 'approved'
            && getAfter(/databases/$(database)/documents/lendingRequests/$(request.resource.data.requestId)).data.lockToken == request.resource.data.lockToken;
        allow delete: if signedIn()
            && getAfter(/databases/$(database)/documents/lendingRequests/$(resource.data.requestId)).data.borrowerUid == currentUid()
            && getAfter(/databases/$(database)/documents/lendingRequests/$(resource.data.requestId)).data.status == 'cancelled'
            && resource.data.lockToken == get(/databases/$(database)/documents/lendingRequests/$(resource.data.requestId)).data.lockToken;
        allow update: if false;
      }
    }

    match /lendingRequests/{requestId} {
      allow get: if signedIn() && currentUid() in resource.data.participantIds;
      allow list: if signedIn()
          && request.query.limit != null
          && request.query.limit <= 50
          && currentUid() in resource.data.participantIds;
      allow create: if signedIn()
          && request.resource.data.borrowerUid == currentUid()
          && validLendingRequest(requestId);
      allow update: if signedIn()
          && currentUid() in resource.data.participantIds
          && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.itemTitle == resource.data.itemTitle
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.borrowerUid == resource.data.borrowerUid
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.startDate == resource.data.startDate
          && request.resource.data.endDate == resource.data.endDate
          && request.resource.data.dayKeys == resource.data.dayKeys
          && request.resource.data.createdAt == resource.data.createdAt
          && validLendingRequestTransition(requestId);
      allow delete: if false;
    }

    match /lendingRatings/{ratingId} {
      allow get: if signedIn();
      allow list: if signedIn()
          && request.query.limit != null
          && request.query.limit <= 100;
      allow create: if signedIn()
          && request.resource.data.keys().hasAll([
            'requestId', 'itemId', 'raterUid', 'recipientUid', 'score',
            'comment', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'requestId', 'itemId', 'raterUid', 'recipientUid', 'score',
            'comment', 'createdAt'
          ])
          && ratingId == request.resource.data.requestId + '_' + currentUid()
          && request.resource.data.raterUid == currentUid()
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/lendingRequests/$(request.resource.data.requestId)).data.status == 'returned'
          && get(/databases/$(database)/documents/lendingRequests/$(request.resource.data.requestId)).data.borrowerUid == currentUid()
          && get(/databases/$(database)/documents/lendingRequests/$(request.resource.data.requestId)).data.itemId == request.resource.data.itemId
          && get(/databases/$(database)/documents/lendingRequests/$(request.resource.data.requestId)).data.ownerUid == request.resource.data.recipientUid
          && getAfter(/databases/$(database)/documents/lendingRequests/$(request.resource.data.requestId)).data.status == 'rated';
      allow update, delete: if false;
    }

    match /chatThreads/{threadId} {
      allow get: if signedIn() && currentUid() in resource.data.participantIds;
      allow list: if signedIn()
          && request.query.limit != null
          && request.query.limit <= 50
          && currentUid() in resource.data.participantIds;
      allow create: if signedIn() && validNewThread(threadId);
      allow update: if signedIn() && validThreadMessageUpdate(threadId);
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isThreadParticipant(threadId);
        allow list: if isThreadParticipant(threadId)
            && request.query.limit != null
            && request.query.limit <= 100;
        allow create: if isThreadParticipant(threadId)
            && validNewMessage(threadId, messageId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
