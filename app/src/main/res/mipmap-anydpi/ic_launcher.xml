<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_brand_warm_cream" />
        </shape>
    </item>
    <item
        android:width="42dp"
        android:height="42dp"
        android:gravity="center">
        <bitmap
            android:antialias="true"
            android:dither="true"
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/propcycle_logo_mascot" />
    </item>
    <item
        android:width="29dp"
        android:height="29dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/pc_brand_deep_blue" />
        </shape>
    </item>
</layer-list>
