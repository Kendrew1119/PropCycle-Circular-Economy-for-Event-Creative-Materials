<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <View
            android:id="@+id/menu_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_recycle_location_doodle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/recycle_center_title"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/recycle_center_subtitle"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/pc_brand_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pc_brand_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/area_input_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/recycle_area_hint"
                    app:boxBackgroundColor="@color/pc_brand_surface"
                    app:boxCornerRadiusBottomEnd="22dp"
                    app:boxCornerRadiusBottomStart="22dp"
                    app:boxCornerRadiusTopEnd="22dp"
                    app:boxCornerRadiusTopStart="22dp"
                    app:boxStrokeColor="@color/pc_brand_primary_blue"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/pc_brand_text_secondary"
                    app:startIconDrawable="@drawable/ic_marketplace_search"
                    app:startIconTint="@color/pc_brand_deep_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/area_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="textCapWords"
                        android:maxLength="80"
                        android:maxLines="1"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textColorHint="@color/pc_brand_text_secondary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/search_area_action"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="@string/recycle_search_area"
                        android:textAllCaps="false"
                        android:textColor="@color/pc_brand_surface"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="12sp"
                        app:backgroundTint="@color/pc_brand_primary_blue"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_search"
                        app:iconPadding="4dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/pc_brand_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/use_location_action"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="@string/recycle_use_location"
                        android:textAllCaps="false"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="12sp"
                        app:backgroundTint="@color/pc_primary_container"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_location"
                        app:iconPadding="4dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/pc_brand_deep_blue" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="top"
                        android:background="@color/pc_brand_outline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/external_map_search_action"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="start|center_vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="42dp"
                        android:text="@string/recycle_external_map_action"
                        android:textAllCaps="false"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="15sp"
                        app:icon="@drawable/ic_location"
                        app:iconGravity="start"
                        app:iconPadding="10dp"
                        app:iconTint="@color/pc_brand_deep_blue" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ai_result_chevron"
                        app:tint="@color/pc_brand_deep_blue" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/pc_brand_soft_blue"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/pc_brand_sky_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_recycle_info"
                        app:tint="@color/pc_brand_deep_blue" />

                    <ProgressBar
                        android:id="@+id/search_progress"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/recycle_searching"
                        android:indeterminateTint="@color/pc_brand_primary_blue"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/recycle_initial_status"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retry_action"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/recycle_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/pc_brand_soft_blue"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/map_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/recycle_map_description">

                <TextView
                    android:id="@+id/map_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pc_brand_soft_blue"
                    android:drawablePadding="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:padding="20dp"
                    android:text="@string/recycle_map_loading"
                    android:textAlignment="center"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp"
                    app:drawableTopCompat="@drawable/ic_recycle_location_doodle" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selected_center_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/pc_brand_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/pc_brand_primary_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_recycle_selected_icon"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_welcome_recycle"
                        app:tint="@color/pc_brand_surface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/selected_center_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka_semibold"
                            android:textColor="@color/pc_brand_deep_blue"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/selected_center_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="2"
                            android:textColor="@color/pc_brand_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/selected_center_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/bg_recycle_distance_chip"
                            android:paddingStart="9dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/pc_brand_deep_blue"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_maps_action"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/fredoka_semibold"
                    android:text="@string/recycle_open_maps"
                    android:textAllCaps="false"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="15sp"
                    app:backgroundTint="@color/pc_brand_surface"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_location"
                    app:iconTint="@color/pc_brand_deep_blue"
                    app:strokeColor="@color/pc_brand_primary_blue"
                    app:strokeWidth="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/nearby_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:drawablePadding="8dp"
            android:fontFamily="@font/fredoka_semibold"
            android:gravity="center_vertical"
            android:text="@string/recycle_nearby_heading"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="21sp"
            app:drawableStartCompat="@drawable/ic_welcome_recycle"
            app:drawableTint="@color/pc_brand_primary_blue" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/center_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingBottom="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/pc_scanner_notice_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/pc_brand_accent_yellow"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_recycle_info"
                    app:tint="@color/pc_brand_accent_yellow" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/recycle_acceptance_notice"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
