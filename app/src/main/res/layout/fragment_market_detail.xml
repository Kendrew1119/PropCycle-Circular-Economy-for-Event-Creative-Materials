<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@android:color/transparent"
                android:contentDescription="Go back"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Item details"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="21sp" />

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_material_box" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/market_detail_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="112dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/pc_brand_primary_blue"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/market_detail_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="@font/fredoka_semibold"
            android:gravity="center"
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="17sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/market_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="286dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_market_detail_photo"
                android:clipToOutline="true"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/listing_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Marketplace item photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:src="@drawable/demo_craft_bundle"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/listing_image_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_market_detail_placeholder"
                    android:contentDescription="Marketplace item image placeholder"
                    android:fontFamily="@font/fredoka_semibold"
                    android:gravity="center"
                    android:text="NO ITEM PHOTO"
                    android:textAlignment="center"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="15sp"
                    tools:visibility="gone" />

                <ProgressBar
                    android:id="@+id/listing_image_progress"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/pc_brand_primary_blue"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/listing_category"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_market_detail_category"
                        android:ellipsize="end"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp"
                        tools:text="Donation  |  Fabric" />

                    <TextView
                        android:id="@+id/listing_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_market_detail_status"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:textColor="@color/pc_brand_surface"
                        android:textSize="14sp"
                        tools:text="Available" />
                </LinearLayout>

                <TextView
                    android:id="@+id/listing_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/fredoka_semibold"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="29sp"
                    tools:text="Event fabric bundle" />

                <TextView
                    android:id="@+id/listing_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="16sp"
                    tools:text="Clean, reusable fabric pieces for costumes, backdrops, and booth displays." />

                <TextView
                    android:id="@+id/listing_condition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_market_detail_info"
                    android:fontFamily="@font/fredoka_semibold"
                    android:padding="14dp"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="14sp"
                    tools:text="Condition: Good  |  Pickup" />

                <TextView
                    android:id="@+id/listing_transaction_terms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_market_detail_info"
                    android:fontFamily="@font/fredoka_semibold"
                    android:padding="14dp"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="14sp"
                    tools:text="Free donation" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_market_detail_seller"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/seller_avatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_market_detail_avatar"
                    android:contentDescription="Seller avatar placeholder"
                    android:fontFamily="@font/fredoka_semibold"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="22sp"
                    tools:text="A" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/seller_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="Community member"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textSize="18sp"
                        tools:text="Aina Rahman" />

                    <TextView
                        android:id="@+id/seller_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Marketplace seller"
                        android:textColor="@color/pc_brand_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/owner_actions_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_market_detail_owner"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka_semibold"
                    android:text="Your listing"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Keep the details current or pause the listing when it is no longer available."
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/edit_listing_action"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_market_detail_secondary_action"
                        android:clickable="true"
                        android:contentDescription="Edit this marketplace listing"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:text="Edit"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/listing_status_action"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_market_detail_primary_action"
                        android:clickable="true"
                        android:contentDescription="Change marketplace listing availability"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:textColor="@color/pc_brand_surface"
                        android:textSize="16sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/owner_action_progress"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/pc_brand_primary_blue"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/owner_action_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/market_detail_cache_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:gravity="center"
                android:text="Offline cache - details may be outdated."
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_action"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_market_detail_primary_action"
                android:clickable="true"
                android:contentDescription="Start a marketplace chat"
                android:focusable="true"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:text="Chat with seller  →"
                android:textColor="@color/pc_brand_surface"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/market_detail_action_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="24dp"
                android:gravity="center"
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
