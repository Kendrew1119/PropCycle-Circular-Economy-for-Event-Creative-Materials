<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@android:color/transparent"
                android:contentDescription="Go back"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Lending details"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="21sp" />

            <ImageView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lending_header_doodle" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_market_detail_photo"
            android:clipToOutline="true"
            android:padding="10dp">

            <ImageView
                android:id="@+id/lending_detail_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_market_detail_placeholder"
                android:clipToOutline="true"
                android:contentDescription="Lending item photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_bottom_nav_lend_out" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lending_detail_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_market_detail_category"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:minHeight="38dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="14sp"
                tools:text="Equipment  •  Good  •  Petaling Jaya" />

            <TextView
                android:id="@+id/lending_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/fredoka_semibold"
                android:lineSpacingExtra="1dp"
                android:text="Lending item"
                android:textColor="@color/pc_brand_text_primary"
                android:textSize="29sp"
                tools:text="Reusable event banner" />

            <TextView
                android:id="@+id/lending_detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="16sp"
                tools:text="A clean event banner available for community use." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_market_detail_info"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka_semibold"
                    android:text="Borrowing terms"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/lending_detail_terms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="15sp"
                    tools:text="Pickup  •  Up to 7 days&#10;No deposit stated" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_market_detail_seller"
            android:gravity="center_vertical"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_market_detail_avatar"
                android:contentDescription="Lending owner"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:text="L"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka_semibold"
                    android:text="Community lender"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/lending_detail_trust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Owner rating: No ratings yet"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/lending_detail_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/lending_detail_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/pc_brand_primary_blue" />

        <LinearLayout
            android:id="@+id/lending_owner_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_lending_action"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="16sp"
                app:backgroundTint="@color/pc_brand_surface"
                app:cornerRadius="20dp"
                app:strokeColor="@color/pc_brand_primary_blue"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_lending_status_action"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Withdraw"
                android:textAllCaps="false"
                android:textColor="@color/pc_brand_surface"
                android:textSize="16sp"
                app:backgroundTint="@color/pc_brand_primary_blue"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/request_lending_action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="Choose dates and request"
            android:textAllCaps="false"
            android:textColor="@color/pc_brand_surface"
            android:textSize="18sp"
            app:backgroundTint="@color/pc_brand_primary_blue"
            app:cornerRadius="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="Chat with owner"
            android:textAllCaps="false"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="17sp"
            app:backgroundTint="@color/pc_brand_surface"
            app:cornerRadius="22dp"
            app:strokeColor="@color/pc_brand_primary_blue"
            app:strokeWidth="2dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
