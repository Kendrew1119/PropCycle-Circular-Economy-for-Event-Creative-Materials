<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:background="@color/pc_surface_mid"
            android:contentDescription="Resource photo preview">

            <TextView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_white"
                android:gravity="center"
                android:text="RESOURCE\nPHOTO"
                android:textAlignment="center"
                android:textColor="@color/pc_text_secondary"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/back_button"
                style="@style/Widget.PropCycle.IconButton"
                android:layout_gravity="top|start"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_horizontal"
            android:layout_marginTop="-22dp"
            android:layout_marginEnd="@dimen/screen_horizontal"
            android:background="@drawable/bg_card_gray"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView
                style="@style/TextAppearance.PropCycle.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="XXXX" />

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="A reusable event resource in good condition, ready for your next creative project."
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@color/pc_border" />

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="Borrow duration     Up to 3 days" />

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Pick-up method      Meet-up" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/screen_horizontal"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_lg">

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Environmental impact"
                android:gravity="center"
                android:text="♻"
                android:textColor="@color/pc_ink"
                android:textSize="27sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Environmental Impact"
                    android:textColor="@color/pc_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Borrowing saves carbon emissions + landfill waste."
                    android:textColor="@color/pc_white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_action"
            style="@style/Widget.PropCycle.Button.Light"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/screen_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="@dimen/screen_horizontal"
            android:text="Chat with XXXX" />
    </LinearLayout>
</ScrollView>
