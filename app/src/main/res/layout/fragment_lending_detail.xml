<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="@dimen/space_xl">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.PropCycle.IconButton"
            android:background="@color/pc_transparent"
            android:contentDescription="Go back"
            android:src="@drawable/ic_back" />

        <ImageView
            android:id="@+id/lending_detail_image"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_lending_listing_card"
            android:contentDescription="Lending item photo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_bottom_nav_lend_out" />

        <TextView
            android:id="@+id/lending_detail_title"
            style="@style/TextAppearance.PropCycle.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Lending item" />

        <TextView
            android:id="@+id/lending_detail_meta"
            style="@style/TextAppearance.PropCycle.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/pc_text_secondary" />

        <TextView
            android:id="@+id/lending_detail_description"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card_light"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/lending_detail_terms"
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lending_detail_trust"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Owner rating: No ratings yet"
                android:textColor="@color/pc_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/lending_detail_status"
            style="@style/TextAppearance.PropCycle.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textColor="@color/pc_text_secondary" />

        <ProgressBar
            android:id="@+id/lending_detail_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/request_lending_action"
            style="@style/Widget.PropCycle.Button.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Choose dates and request" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_action"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Chat with owner" />

        <LinearLayout
            android:id="@+id/lending_owner_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_lending_action"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_lending_status_action"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="Withdraw" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
