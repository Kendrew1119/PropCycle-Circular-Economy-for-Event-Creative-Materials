<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_messages_thread"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/thread_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_messages_avatar"
        android:fontFamily="@font/fredoka_semibold"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="P"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="22sp"
        tools:text="A" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/thread_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/fredoka_semibold"
            android:maxLines="1"
            android:textColor="@color/pc_brand_text_primary"
            android:textSize="18sp"
            tools:text="Event fabric bundle" />

        <TextView
            android:id="@+id/thread_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="14sp"
            tools:text="Is the item still available?" />
    </LinearLayout>

    <TextView
        android:id="@+id/thread_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="8dp"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:textColor="@color/pc_brand_text_secondary"
        android:textSize="12sp"
        tools:text="10:24 AM" />
</LinearLayout>
