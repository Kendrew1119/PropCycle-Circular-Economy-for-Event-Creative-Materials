<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_welcome_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingTop="@dimen/screen_vertical"
    android:paddingEnd="@dimen/screen_horizontal"
    android:paddingBottom="@dimen/screen_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/menu_button"
                style="@style/Widget.PropCycle.IconButton"
                android:background="@color/pc_transparent"
                android:contentDescription="Open navigation menu"
                android:src="@drawable/ic_menu" />

            <TextView
                android:id="@+id/create_listing_heading"
                style="@style/TextAppearance.PropCycle.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Complete your\nlisting"
                android:textSize="31sp" />

            <ImageView
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:scaleType="centerInside"
                android:src="@drawable/ic_listing_burst" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/create_listing_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs">

            <FrameLayout
                android:id="@+id/listing_photo_container"
                android:layout_width="@dimen/create_listing_photo_width"
                android:layout_height="@dimen/create_listing_photo_height"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_create_listing_photo"
                android:clipToOutline="true"
                android:elevation="@dimen/elevation_subtle"
                android:outlineProvider="background">

                <ImageView
                    android:id="@+id/listing_photo_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Selected marketplace item photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/listing_photo_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Marketplace item photo placeholder"
                    android:gravity="center"
                    android:padding="@dimen/space_md"
                    android:text="Add one clear item photo\n(optional)"
                    android:textAlignment="center"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/listing_photo_progress"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/photo_add_action"
                    style="@style/Widget.PropCycle.IconButton"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/ai_result_section_spacing"
                    android:layout_marginBottom="@dimen/ai_result_section_spacing"
                    android:contentDescription="Add or change item photo"
                    android:elevation="@dimen/elevation_subtle"
                    android:src="@drawable/ic_add" />
            </FrameLayout>

            <TextView
                android:id="@+id/photo_clear_action"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xs"
                android:clickable="true"
                android:contentDescription="Clear the newly selected marketplace photo"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Clear new photo"
                android:textColor="@color/pc_text_secondary"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/listing_title_input"
                android:text="Item name"
                android:textColor="@color/pc_text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/listing_title_input"
                style="@style/Widget.PropCycle.CreateListing.Field"
                android:layout_marginTop="0dp"
                android:hint="Enter item name"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:maxLines="1" />

            <TextView
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/listing_category_input"
                android:text="Category"
                android:textColor="@color/pc_text_primary"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/listing_category_input"
                style="@style/Widget.PropCycle.CreateListing.Field"
                android:layout_marginTop="0dp"
                android:hint="Select category"
                android:importantForAutofill="no"
                android:inputType="none"
                android:maxLines="1" />

            <TextView
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/listing_condition_input"
                android:text="Condition"
                android:textColor="@color/pc_text_primary"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/listing_condition_input"
                style="@style/Widget.PropCycle.CreateListing.Field"
                android:layout_marginTop="0dp"
                android:hint="Select condition"
                android:importantForAutofill="no"
                android:inputType="none"
                android:maxLines="1" />

            <AutoCompleteTextView
                android:id="@+id/listing_transaction_input"
                style="@style/Widget.PropCycle.CreateListing.Field"
                android:importantForAutofill="no"
                android:inputType="none"
                android:maxLines="1"
                android:visibility="gone" />

            <TextView
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/listing_fulfilment_input"
                android:text="Pickup"
                android:textColor="@color/pc_text_primary"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/listing_fulfilment_input"
                style="@style/Widget.PropCycle.CreateListing.Field"
                android:layout_marginTop="0dp"
                android:hint="Select pickup or meet-up"
                android:importantForAutofill="no"
                android:inputType="none"
                android:maxLines="1" />

            <EditText
                android:id="@+id/listing_price_input"
                style="@style/Widget.PropCycle.CreateListing.Field"
                android:layout_marginTop="10dp"
                android:digits="0123456789."
                android:hint="Price (RM)"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:visibility="gone" />

            <EditText
                android:id="@+id/listing_exchange_terms_input"
                style="@style/Widget.PropCycle.CreateListing.Description"
                android:layout_height="82dp"
                android:layout_marginTop="10dp"
                android:gravity="top|start"
                android:hint="What would you accept in exchange?"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:maxLines="4"
                android:paddingTop="16dp"
                android:visibility="gone" />

            <TextView
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/listing_description_input"
                android:text="Description"
                android:textColor="@color/pc_text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/listing_description_input"
                style="@style/Widget.PropCycle.CreateListing.Description"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="Describe your item"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1000"
                android:maxLines="5" />

            <TextView
                android:id="@+id/create_listing_media_note"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:lineSpacingExtra="2dp"
                android:text="One photo is securely uploaded only when you publish."
                android:textColor="@color/pc_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/create_listing_status"
            style="@style/TextAppearance.PropCycle.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/pc_error"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/create_listing_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/create_listing_upload_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/create_listing_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:scaleType="centerInside"
                android:src="@drawable/ic_listing_megaphone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/primary_action"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="92dp"
                android:layout_height="@dimen/touch_target"
                android:background="@drawable/bg_pill_dark"
                android:clickable="true"
                android:contentDescription="Publish marketplace listing"
                android:focusable="true"
                android:gravity="center"
                android:text="Publish"
                android:textColor="@color/pc_on_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
