<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/menu_button"
                style="@style/Widget.PropCycle.IconButton"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_create_listing_secondary_action"
                android:contentDescription="Open navigation menu"
                android:src="@drawable/ic_settings"
                app:tint="@color/pc_brand_deep_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/create_listing_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka_semibold"
                    android:lineSpacingExtra="-2dp"
                    android:text="Complete your&#10;listing"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Give useful materials their next event."
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_listing_burst" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/create_listing_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/listing_photo_container"
                android:layout_width="match_parent"
                android:layout_height="226dp"
                android:background="@drawable/bg_create_listing_hero"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:outlineProvider="background"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/listing_photo_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Selected marketplace item photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/listing_photo_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_create_listing_upload_placeholder"
                    android:contentDescription="Marketplace item photo placeholder"
                    android:fontFamily="@font/fredoka_semibold"
                    android:gravity="bottom|start"
                    android:padding="18dp"
                    android:text="Add one clear item photo&#10;(optional)"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="19sp" />

                <ProgressBar
                    android:id="@+id/listing_photo_progress"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/pc_brand_primary_blue"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/photo_add_action"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_create_listing_photo_action"
                    android:contentDescription="Add or change item photo"
                    android:elevation="4dp"
                    android:padding="14dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/pc_brand_surface" />
            </FrameLayout>

            <TextView
                android:id="@+id/photo_clear_action"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:contentDescription="Clear the newly selected marketplace photo"
                android:focusable="true"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Clear new photo"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/fredoka_semibold"
                android:labelFor="@id/listing_title_input"
                android:text="Item title"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/listing_title_input"
                style="@style/Widget.PropCycle.Field"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_create_listing_input"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:hint="e.g. Blue event fabric bundle"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/pc_brand_text_primary"
                android:textColorHint="@color/pc_brand_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:labelFor="@id/listing_category_input"
                        android:text="Category"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="16sp" />

                    <AutoCompleteTextView
                        android:id="@+id/listing_category_input"
                        style="@style/Widget.PropCycle.Field"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_create_listing_input"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Category"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textColorHint="@color/pc_brand_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:labelFor="@id/listing_condition_input"
                        android:text="Condition"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="16sp" />

                    <AutoCompleteTextView
                        android:id="@+id/listing_condition_input"
                        style="@style/Widget.PropCycle.Field"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_create_listing_input"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Condition"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textColorHint="@color/pc_brand_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:labelFor="@id/listing_transaction_input"
                        android:text="Offer type"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="16sp" />

                    <AutoCompleteTextView
                        android:id="@+id/listing_transaction_input"
                        style="@style/Widget.PropCycle.Field"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_create_listing_input"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Donation"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textColorHint="@color/pc_brand_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:labelFor="@id/listing_fulfilment_input"
                        android:text="Hand-over"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="16sp" />

                    <AutoCompleteTextView
                        android:id="@+id/listing_fulfilment_input"
                        style="@style/Widget.PropCycle.Field"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_create_listing_input"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Pickup"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textColorHint="@color/pc_brand_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/listing_price_input"
                style="@style/Widget.PropCycle.Field"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_create_listing_input"
                android:digits="0123456789."
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:hint="Price (RM)"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/pc_brand_text_primary"
                android:textColorHint="@color/pc_brand_text_secondary"
                android:visibility="gone" />

            <EditText
                android:id="@+id/listing_exchange_terms_input"
                style="@style/Widget.PropCycle.Field"
                android:layout_height="98dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_create_listing_description"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="What would you accept in exchange?"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:maxLines="4"
                android:padding="16dp"
                android:textColor="@color/pc_brand_text_primary"
                android:textColorHint="@color/pc_brand_text_secondary"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/fredoka_semibold"
                android:labelFor="@id/listing_description_input"
                android:text="Description"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/listing_description_input"
                style="@style/Widget.PropCycle.Field"
                android:layout_height="128dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_create_listing_description"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="Describe your item, its size, quantity, and any details that will help others."
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1000"
                android:maxLines="5"
                android:padding="16dp"
                android:textColor="@color/pc_brand_text_primary"
                android:textColorHint="@color/pc_brand_text_secondary" />

            <TextView
                android:id="@+id/create_listing_media_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_create_listing_note"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:text="One photo is securely uploaded only when you publish."
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/create_listing_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/pc_error"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/create_listing_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/pc_brand_primary_blue"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/create_listing_upload_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:visibility="gone"
            app:indicatorColor="@color/pc_brand_primary_blue"
            app:trackColor="@color/pc_brand_soft_blue" />

        <LinearLayout
            android:id="@+id/create_listing_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/primary_action"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_create_listing_primary_action"
                android:clickable="true"
                android:contentDescription="Publish marketplace listing"
                android:focusable="true"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:text="Publish"
                android:textColor="@color/pc_brand_surface"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
