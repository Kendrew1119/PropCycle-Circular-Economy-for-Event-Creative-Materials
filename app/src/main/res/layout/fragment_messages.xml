<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/screen_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/menu_button"
            style="@style/Widget.PropCycle.IconButton"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_settings" />

        <TextView
            style="@style/TextAppearance.PropCycle.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Messages" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_text"
        style="@style/TextAppearance.PropCycle.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_card_light"
        android:padding="@dimen/space_md"
        android:textColor="@color/pc_ink"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_2xl"
        android:contentDescription="Loading conversations" />

    <TextView
        android:id="@+id/empty_text"
        style="@style/TextAppearance.PropCycle.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xl"
        android:gravity="center"
        android:padding="@dimen/space_lg"
        android:text="No conversations yet. Open a marketplace listing to chat with its owner."
        android:textAlignment="center"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/conversation_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_lg"
        android:scrollbars="vertical" />
</LinearLayout>
