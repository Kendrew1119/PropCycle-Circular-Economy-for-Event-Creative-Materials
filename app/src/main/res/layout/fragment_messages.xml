<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_messages_menu"
            android:contentDescription="@string/menu"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/pc_brand_deep_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginEnd="120dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Messages"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="36sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Keep good materials moving."
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="130dp"
            android:layout_height="98dp"
            android:layout_gravity="end|bottom"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/messages_header_envelope" />
    </FrameLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_messages_status"
        android:padding="14dp"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="14sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="Loading conversations"
            android:indeterminateTint="@color/pc_brand_primary_blue" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_messages_empty"
            android:fontFamily="@font/fredoka_semibold"
            android:gravity="center"
            android:padding="28dp"
            android:text="No conversations yet. Open a marketplace listing to chat with its owner."
            android:textAlignment="center"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="17sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conversation_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="18dp"
            android:scrollbars="vertical"
            tools:itemCount="4"
            tools:listitem="@layout/item_chat_thread" />
    </FrameLayout>
</LinearLayout>
