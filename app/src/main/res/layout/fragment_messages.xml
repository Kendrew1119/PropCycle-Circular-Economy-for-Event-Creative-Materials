<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_messages_menu"
            android:contentDescription="@string/menu"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/pc_brand_deep_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="30dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="94dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Messages"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="36sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Keep good materials moving."
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/pc_sticker_messages_mailbox" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_messages_header_divider"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_messages_status"
        android:padding="14dp"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="14sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="Loading conversations"
            android:indeterminateTint="@color/pc_brand_primary_blue" />

        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="@null"
                android:src="@drawable/pc_sticker_bunny_mail_cutout" />

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_messages_empty"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:padding="28dp"
                android:text="No conversations yet. Open a marketplace listing to chat with its owner."
                android:textAlignment="center"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="17sp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conversation_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="18dp"
            android:scrollbars="vertical"
            tools:itemCount="4"
            tools:listitem="@layout/item_chat_thread" />
    </FrameLayout>
</LinearLayout>
