<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginEnd="104dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Lending updates"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="34sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Requests and returns, in one place."
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="end|bottom"
            android:contentDescription="@null"
            android:src="@drawable/ic_notifications_doodles" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage lending requests and returns here. Phone push notifications are not enabled."
        android:textColor="@color/pc_brand_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/lending_request_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_notifications_status"
        android:fontFamily="@font/fredoka_semibold"
        android:padding="12dp"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="14sp"
        tools:text="2 lending updates" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/lending_request_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/pc_brand_primary_blue" />

        <TextView
            android:id="@+id/lending_request_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_notifications_empty"
            android:fontFamily="@font/fredoka_semibold"
            android:gravity="center"
            android:padding="28dp"
            android:text="No lending updates yet."
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="17sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lending_request_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="18dp"
            android:scrollbars="vertical"
            tools:itemCount="3"
            tools:listitem="@layout/item_lending_request" />
    </FrameLayout>
</LinearLayout>
