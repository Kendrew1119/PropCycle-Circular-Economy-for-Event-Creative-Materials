<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="68dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginEnd="68dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Notifications"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="30sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@null"
            android:src="@drawable/ic_notifications"
            app:tint="@color/pc_brand_primary_blue" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chat messages stay in Messages. Updates are shown here inside PropCycle."
        android:textColor="@color/pc_brand_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/fredoka_semibold"
        android:text="MARKETPLACE STATUS"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/marketplace_update_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_notifications_status"
        android:fontFamily="@font/fredoka_semibold"
        android:padding="12dp"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="14sp"
        tools:text="1 recent sold listing update" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/marketplace_update_list"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:scrollbars="horizontal"
            tools:itemCount="2"
            tools:listitem="@layout/item_marketplace_status_notice" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/fredoka_semibold"
        android:text="LENDING STATUS"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/lending_request_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_notifications_status"
        android:fontFamily="@font/fredoka_semibold"
        android:padding="12dp"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="14sp"
        tools:text="2 lending updates" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/lending_request_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/pc_brand_primary_blue" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lending_request_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="18dp"
            android:scrollbars="vertical"
            tools:itemCount="3"
            tools:listitem="@layout/item_lending_request" />
    </FrameLayout>
</LinearLayout>
