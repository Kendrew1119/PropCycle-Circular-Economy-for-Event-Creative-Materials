<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/app_header"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_header_height"
            android:background="@color/pc_brand_primary_blue"
            android:elevation="3dp"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_xs"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/app_header_settings"
                style="@style/Widget.PropCycle.IconButton"
                android:background="@drawable/bg_circle_header_settings"
                android:contentDescription="@string/home_settings_open"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/pc_brand_deep_blue" />

            <TextView
                android:id="@+id/app_header_title"
                style="@style/TextAppearance.PropCycle.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/pc_on_primary"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/app_header_notifications"
                style="@style/Widget.PropCycle.IconButton"
                android:background="@drawable/bg_circle_header_action"
                android:contentDescription="@string/notifications"
                android:padding="12dp"
                android:src="@drawable/ic_notifications"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/app_header_profile"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/pc_brand_deep_blue" />

            <ImageButton
                android:id="@+id/app_header_profile"
                style="@style/Widget.PropCycle.IconButton"
                android:layout_marginStart="@dimen/space_xs"
                android:background="@drawable/bg_circle_header_action"
                android:contentDescription="@string/profile"
                android:padding="12dp"
                android:src="@drawable/ic_person"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/pc_brand_deep_blue" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_header"
            app:navGraph="@navigation/nav_graph" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            style="@style/Widget.MaterialComponents.BottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_navigation_height"
            android:background="@drawable/bg_bottom_navigation"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            app:itemActiveIndicatorStyle="@null"
            app:itemHorizontalTranslationEnabled="false"
            app:itemIconSize="@dimen/bottom_navigation_icon_size"
            app:itemIconTint="@color/bottom_navigation_item_tint"
            app:itemPaddingTop="8dp"
            app:itemPaddingBottom="3dp"
            app:itemTextAppearanceActive="@style/TextAppearance.PropCycle.BottomNavigation.Active"
            app:itemTextAppearanceInactive="@style/TextAppearance.PropCycle.BottomNavigation"
            app:itemTextColor="@color/bottom_navigation_item_tint"
            app:labelMaxLines="2"
            app:measureBottomPaddingFromLabelBaseline="false"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/menu_bottom_navigation" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/status_bar_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/pc_brand_primary_blue"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/system_navigation_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="@color/pc_brand_deep_blue"
        android:importantForAccessibility="no" />
</FrameLayout>