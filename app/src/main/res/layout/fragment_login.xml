<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="@dimen/space_lg">

        <ImageButton
            android:id="@+id/close_button"
            style="@style/Widget.PropCycle.IconButton"
            android:layout_gravity="end"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Close sign in"
            android:src="@drawable/ic_close" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-32dp"
            android:text="Welcome Back"
            android:textAppearance="@style/TextAppearance.PropCycle.Heading" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_lg"
            android:text="You've been missed!"
            android:textAppearance="@style/TextAppearance.PropCycle.Body" />

        <EditText
            android:id="@+id/email_input"
            style="@style/Widget.PropCycle.Field"
            android:layout_marginBottom="@dimen/space_md"
            android:autofillHints="emailAddress"
            android:hint="Email"
            android:importantForAutofill="yes"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:maxLines="1" />

        <EditText
            android:id="@+id/password_input"
            style="@style/Widget.PropCycle.Field"
            android:layout_marginBottom="@dimen/space_md"
            android:autofillHints="password"
            android:hint="Password"
            android:importantForAutofill="yes"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1" />

        <TextView
            android:id="@+id/auth_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PropCycle.Caption"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary_action"
                style="@style/Widget.PropCycle.Button.Dark"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sign In" />

            <ProgressBar
                android:id="@+id/auth_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/pc_white"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/secondary_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Don't have an account?  Register"
            android:textAppearance="@style/TextAppearance.PropCycle.Caption"
            android:textColor="@color/pc_ink" />
    </LinearLayout>

</FrameLayout>
