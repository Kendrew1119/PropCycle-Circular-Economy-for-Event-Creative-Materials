<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_welcome_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:importantForAccessibility="no">

        <ImageView
            android:layout_width="@dimen/login_brand_logo_size"
            android:layout_height="@dimen/login_brand_logo_size"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_md"
            android:scaleType="centerInside"
            android:src="@drawable/ic_launcher_foreground" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/space_2xl"
            android:layout_marginTop="40dp"
            android:alpha="0.30"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:rotation="-8"
            android:src="@drawable/ic_welcome_leaf" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginEnd="50dp"
            android:alpha="0.22"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_welcome_sparkle" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="92dp"
            android:layout_marginTop="126dp"
            android:alpha="0.24"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_welcome_heart" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="116dp"
            android:layout_marginEnd="82dp"
            android:alpha="0.28"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:rotation="7"
            android:src="@drawable/ic_welcome_package" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/login_panel_min_height"
                android:background="@drawable/bg_login_panel"
                android:elevation="@dimen/elevation_subtle"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:outlineProvider="background"
                android:paddingStart="@dimen/screen_horizontal"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/screen_horizontal"
                android:paddingBottom="@dimen/space_lg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginEnd="@dimen/space_2xl"
                        android:text="Welcome Back"
                        android:textAppearance="@style/TextAppearance.PropCycle.Heading" />

                    <ImageButton
                        android:id="@+id/close_button"
                        style="@style/Widget.PropCycle.IconButton"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_circle_white"
                        android:contentDescription="Close sign in"
                        android:src="@drawable/ic_close" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_lg"
                    android:text="Welcome back to PropCycle."
                    android:textAppearance="@style/TextAppearance.PropCycle.Body"
                    android:textColor="@color/pc_text_secondary" />

                <EditText
                    android:id="@+id/email_input"
                    style="@style/Widget.PropCycle.Field"
                    android:background="@drawable/bg_login_field"
                    android:layout_marginBottom="@dimen/space_md"
                    android:autofillHints="emailAddress"
                    android:hint="Email"
                    android:importantForAutofill="yes"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/password_input"
                    style="@style/Widget.PropCycle.Field"
                    android:background="@drawable/bg_login_field"
                    android:layout_marginBottom="@dimen/space_md"
                    android:autofillHints="password"
                    android:hint="Password"
                    android:importantForAutofill="yes"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/auth_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.PropCycle.Caption"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/primary_action"
                        style="@style/Widget.PropCycle.Button.Dark"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Sign In" />

                    <ProgressBar
                        android:id="@+id/auth_progress"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/pc_white"
                        android:visibility="gone" />
                </FrameLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/secondary_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:clickable="true"
                    android:contentDescription="Don't have an account? Register"
                    android:focusable="true"
                    android:minHeight="@dimen/touch_target">

                    <TextView
                        android:id="@+id/login_register_prompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="Don't have an account?"
                        android:textAppearance="@style/TextAppearance.PropCycle.Caption"
                        android:textColor="@color/pc_text_secondary" />

                    <TextView
                        android:id="@+id/login_register_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="Register"
                        android:textAppearance="@style/TextAppearance.PropCycle.Caption"
                        android:textColor="@color/pc_primary"
                        android:textStyle="bold" />

                    <androidx.constraintlayout.helper.widget.Flow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        app:constraint_referenced_ids="login_register_prompt,login_register_action"
                        app:flow_horizontalAlign="center"
                        app:flow_horizontalGap="@dimen/space_xs"
                        app:flow_horizontalStyle="packed"
                        app:flow_wrapMode="chain"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
