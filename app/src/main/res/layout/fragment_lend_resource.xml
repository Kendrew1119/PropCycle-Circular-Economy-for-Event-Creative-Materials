<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/back_button"
                    style="@style/Widget.PropCycle.IconButton"
                    android:background="@color/pc_transparent"
                    android:contentDescription="Go back"
                    android:src="@drawable/ic_back"
                    app:tint="@color/pc_brand_deep_blue" />

                <TextView
                    android:id="@+id/lend_form_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/fredoka_semibold"
                    android:text="Lend Resource"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:lineSpacingExtra="2dp"
                android:text="Share useful equipment safely. Deposits are informational and handled outside PropCycle."
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/pc_brand_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pc_brand_primary_blue"
            app:strokeWidth="2dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/lending_photo_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_lend_photo_preview"
                    android:clipToOutline="true"
                    android:contentDescription="Selected lending photo"
                    android:cropToPadding="true"
                    android:outlineProvider="background"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bottom_nav_lend_out" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/photo_clear_action"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_photo_action_delete"
                        android:contentDescription="Remove photo"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_lend_delete"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/photo_add_action"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_create_listing_photo_action"
                        android:contentDescription="Add or change item photo"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_add"
                        app:tint="@color/pc_brand_surface" />
                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Item title"
            app:boxBackgroundColor="@color/pc_brand_surface"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/lend_field_stroke"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="@color/pc_brand_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lending_title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:minHeight="48dp"
                android:textColor="@color/pc_brand_text_primary"
                android:textColorHint="@color/pc_brand_text_secondary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Category"
                app:boxBackgroundColor="@color/pc_brand_surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/lend_field_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="none"
                app:hintTextColor="@color/pc_brand_text_secondary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/lending_category_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:inputType="none"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="Condition"
                app:boxBackgroundColor="@color/pc_brand_surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/lend_field_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="none"
                app:hintTextColor="@color/pc_brand_text_secondary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/lending_condition_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:inputType="none"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Maximum days"
                app:boxBackgroundColor="@color/pc_brand_surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/lend_field_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/pc_brand_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/lending_max_days_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:minHeight="48dp"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="Deposit RM (optional)"
                app:boxBackgroundColor="@color/pc_brand_surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/lend_field_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/pc_brand_text_secondary"
                app:prefixText="RM ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/lending_deposit_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLength="10"
                    android:minHeight="48dp"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textColorHint="@color/pc_brand_text_secondary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.PropCycle.DropdownField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:foreground="@null"
            android:hint="Pickup method"
            app:boxBackgroundColor="@color/pc_brand_surface"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/lend_field_stroke"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:startIconDrawable="@drawable/ic_location"
            app:startIconTint="@color/pc_brand_deep_blue">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/lending_pickup_input"
                style="@style/Widget.PropCycle.DropdownInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:inputType="none"
                android:maxLines="1"
                android:minHeight="48dp"
                android:textColor="@color/pc_brand_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Public area or meeting point"
            app:boxBackgroundColor="@color/pc_brand_surface"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/lend_field_stroke"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="@color/pc_brand_text_secondary"
            app:startIconDrawable="@drawable/ic_location"
            app:startIconTint="@color/pc_brand_deep_blue">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lending_area_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLength="100"
                android:minHeight="48dp"
                android:textColor="@color/pc_brand_text_primary"
                android:textColorHint="@color/pc_brand_text_secondary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/pc_brand_soft_blue"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/pc_brand_sky_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_location"
                    app:tint="@color/pc_brand_deep_blue" />

                <TextView
                    android:id="@+id/lending_location_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:text="No map point attached"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/attach_location_action"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Attach current area"
                        android:textColor="@color/pc_brand_primary_blue"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_ai_result_chevron"
                        app:iconGravity="textEnd"
                        app:iconPadding="4dp"
                        app:iconTint="@color/pc_brand_primary_blue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clear_location_action"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Clear"
                        android:textColor="@color/pc_brand_accent_red"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:layout_width="52dp"
            android:layout_height="20dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:alpha="0.26"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_recent_squiggle" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Description"
            app:boxBackgroundColor="@color/pc_brand_surface"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/lend_field_stroke"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="@color/pc_brand_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lending_description_input"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:lineSpacingExtra="3dp"
                android:maxLength="1000"
                android:textColor="@color/pc_brand_text_primary"
                android:textColorHint="@color/pc_brand_text_secondary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/lending_form_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_scanner_status_card"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_scanner_status_camera"
            android:drawableTint="@color/pc_brand_deep_blue"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:minHeight="@dimen/touch_target"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="13sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/lending_form_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:indeterminateTint="@color/pc_brand_primary_blue"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary_action"
                style="@style/Widget.PropCycle.Button.Dark"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="240dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Publish"
                android:textColor="@color/pc_on_primary"
                android:textSize="16sp"
                app:backgroundTint="@color/pc_brand_primary_blue"
                app:cornerRadius="26dp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:alpha="0.76"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_recent_sparkle" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
