<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingTop="@dimen/screen_vertical"
    android:paddingEnd="@dimen/screen_horizontal"
    android:paddingBottom="@dimen/screen_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/menu_button"
            style="@style/Widget.PropCycle.IconButton"
            android:background="@color/pc_transparent"
            android:contentDescription="Open navigation menu"
            android:src="@drawable/ic_settings" />

        <TextView
            style="@style/TextAppearance.PropCycle.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lend Resource" />

        <TextView
            style="@style/TextAppearance.PropCycle.Caption"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Share your resource with others and help extend its lifecycle."
            android:textColor="@color/pc_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:contentDescription="House and heart illustration"
            android:fontFamily="sans"
            android:gravity="end|center_vertical"
            android:text="♡   ⌂"
            android:textColor="@color/pc_ink"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_outline"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/TextAppearance.PropCycle.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Resource Preview"
                android:textSize="17sp" />

            <TextView
                android:layout_width="122dp"
                android:layout_height="128dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_light"
                android:contentDescription="Resource photo placeholder"
                android:gravity="center"
                android:text="Item Photo"
                android:textColor="@color/pc_text_secondary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_gray"
                    android:gravity="center"
                    android:text="□"
                    android:textColor="@color/pc_ink"
                    android:textSize="19sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.PropCycle.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Borrow Duration"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.PropCycle.Caption"
                        android:layout_width="120dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center"
                        android:text="3 days" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_gray"
                    android:gravity="center"
                    android:text="$"
                    android:textColor="@color/pc_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.PropCycle.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deposit (Optional)"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.PropCycle.Caption"
                        android:layout_width="120dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center"
                        android:text="RM 20" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_gray"
                    android:gravity="center"
                    android:text="↔"
                    android:textColor="@color/pc_ink"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.PropCycle.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pick-up Method"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.PropCycle.Caption"
                        android:layout_width="160dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center"
                        android:text="Meet-up nearby" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_gray"
                    android:gravity="center"
                    android:text="≡"
                    android:textColor="@color/pc_ink"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.PropCycle.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.PropCycle.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Clean and ready to share" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/primary_action"
            style="@style/TextAppearance.PropCycle.Caption"
            android:layout_width="108dp"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="end"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:contentDescription="Publish lending resource"
            android:focusable="true"
            android:gravity="center"
            android:text="Publish Listing"
            android:textColor="@color/pc_ink"
            android:textStyle="bold" />

        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />
    </LinearLayout>
</ScrollView>
