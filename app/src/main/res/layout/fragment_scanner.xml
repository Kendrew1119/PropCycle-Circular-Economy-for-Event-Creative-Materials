<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream">

    <ImageView
        android:layout_width="58dp"
        android:layout_height="36dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="-16dp"
        android:layout_marginTop="128dp"
        android:alpha="0.34"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_recent_squiggle" />

    <ImageView
        android:layout_width="34dp"
        android:layout_height="54dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="250dp"
        android:layout_marginEnd="-4dp"
        android:alpha="0.22"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_bottle" />

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="18dp"
        android:alpha="0.72"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_scanner_sparkle_red" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:alpha="0.62"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_scanner_rays_yellow" />

    <ImageView
        android:layout_width="66dp"
        android:layout_height="50dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="-18dp"
        android:layout_marginBottom="74dp"
        android:alpha="0.19"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_fabric_roll" />

    <ImageView
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="-12dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.16"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_box" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="32dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target">

                <ImageButton
                    android:id="@+id/back_button"
                    style="@style/Widget.PropCycle.IconButton"
                    android:background="@drawable/bg_scanner_back_button"
                    android:contentDescription="@string/back"
                    android:padding="13dp"
                    android:src="@drawable/ic_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/pc_brand_deep_blue" />

                <TextView
                    android:id="@+id/scanner_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka_semibold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/scanner_title"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/scanner_header_end_spacer"
                    app:layout_constraintStart_toEndOf="@id/back_button"
                    app:layout_constraintTop_toTopOf="parent" />

                <Space
                    android:id="@+id/scanner_header_end_spacer"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/scanner_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/scanner_subtitle"
                android:textAlignment="center"
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="15sp" />

            <FrameLayout
                android:id="@+id/scanner_preview_container"
                android:layout_width="@dimen/scanner_preview_size"
                android:layout_height="@dimen/scanner_preview_size"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_scanner_viewport"
                android:contentDescription="@string/scanner_preview_description"
                android:elevation="4dp"
                android:outlineProvider="background"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/selected_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/scanner_preview_description"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/scanner_preview_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pc_brand_deep_blue"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:padding="48dp"
                    android:text="@string/scanner_preview_placeholder"
                    android:textAlignment="center"
                    android:textColor="@color/pc_on_primary"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/scan_frame_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:contentDescription="@string/scanner_frame_description"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/scan_frame_scanner" />

                <ProgressBar
                    android:id="@+id/scanner_progress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/scanner_progress_description"
                    android:indeterminateTint="@color/pc_on_primary"
                    android:visibility="gone" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/scanner_state_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_scanner_status_card"
                android:elevation="2dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_scanner_status_icon"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_scanner_status_camera" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/scanner_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/scanner_initial_status"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retry_action"
                    style="@style/Widget.PropCycle.Button.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="8dp"
                    android:minWidth="128dp"
                    android:text="@string/scanner_retry"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:visibility="gone"
                    app:backgroundTint="@color/pc_brand_soft_blue" />

            </LinearLayout>

            <CheckBox
                android:id="@+id/scanner_disclosure_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="@dimen/touch_target"
                android:buttonTint="@color/pc_brand_primary_blue"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/scanner_disclosure_consent"
                android:textColor="@color/pc_brand_text_primary"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/analyze_action"
                style="@style/Widget.PropCycle.Button.Dark"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:enabled="false"
                android:text="@string/scanner_analyse"
                android:textSize="16sp"
                app:backgroundTint="@color/scanner_analyze_button_tint"
                app:icon="@drawable/ic_scanner_analyse_sparkle"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/pc_on_primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/primary_action"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_scanner_camera_action"
                        android:contentDescription="@string/camera"
                        android:elevation="3dp"
                        android:padding="17dp"
                        android:src="@drawable/ic_camera" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/scanner_take_photo"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/secondary_action"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_scanner_gallery_action"
                        android:contentDescription="@string/gallery"
                        android:elevation="3dp"
                        android:padding="18dp"
                        android:src="@drawable/ic_gallery"
                        app:tint="@color/pc_brand_deep_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/scanner_choose_photo"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
