<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingTop="@dimen/screen_vertical"
    android:paddingEnd="@dimen/screen_horizontal"
    android:paddingBottom="@dimen/screen_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="72dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_card_light"
            android:contentDescription="Welcome illustration placeholder"
            android:importantForAccessibility="yes">

            <TextView
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_gray"
                android:gravity="center"
                android:text="♻"
                android:textColor="@color/pc_ink"
                android:textSize="70sp" />

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="38dp"
                android:layout_marginTop="38dp"
                android:background="@drawable/bg_circle_white"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/pc_border"
                android:textSize="32sp" />

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="36dp"
                android:background="@drawable/bg_circle_gray"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/pc_white"
                android:textSize="38sp" />

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="52dp"
                android:layout_marginBottom="34dp"
                android:background="@drawable/bg_circle_gray"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/pc_white"
                android:textSize="26sp" />

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="42dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_circle_white"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/pc_border"
                android:textSize="34sp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text"
            android:textAppearance="@style/TextAppearance.PropCycle.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Text"
            android:textAppearance="@style/TextAppearance.PropCycle.Body" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/primary_action"
        style="@style/Widget.PropCycle.Button.Dark"
        android:layout_width="88dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_lg"
        android:contentDescription="Continue to sign in"
        android:text="Go!" />

</FrameLayout>
