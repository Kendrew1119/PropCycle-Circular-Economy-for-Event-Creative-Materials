<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_welcome_background"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingTop="@dimen/screen_vertical"
    android:paddingEnd="@dimen/screen_horizontal"
    android:paddingBottom="@dimen/screen_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="72dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/bg_welcome_illustration_card"
            android:contentDescription="Welcome illustration placeholder"
            android:elevation="@dimen/elevation_subtle"
            android:importantForAccessibility="yes">

            <ImageView
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_gray"
                android:contentDescription="PropCycle check-mark logo"
                android:padding="@dimen/space_md"
                android:scaleType="centerInside"
                android:src="@drawable/ic_launcher_foreground"
                app:tint="@color/pc_primary" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="26dp"
                android:layout_marginTop="48dp"
                android:alpha="0.48"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="-8"
                android:src="@drawable/ic_welcome_leaf" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="94dp"
                android:layout_marginTop="28dp"
                android:alpha="0.32"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_welcome_sparkle" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="44dp"
                android:layout_marginEnd="32dp"
                android:alpha="0.42"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="7"
                android:src="@drawable/ic_welcome_heart" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="28dp"
                android:alpha="0.36"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_welcome_package" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="28dp"
                android:layout_marginBottom="72dp"
                android:alpha="0.40"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="-6"
                android:src="@drawable/ic_welcome_package" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="82dp"
                android:layout_marginBottom="24dp"
                android:alpha="0.30"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_welcome_heart" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="82dp"
                android:layout_marginBottom="24dp"
                android:alpha="0.28"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="10"
                android:src="@drawable/ic_welcome_leaf" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="54dp"
                android:alpha="0.44"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_welcome_sparkle" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PropCycle"
            android:textAppearance="@style/TextAppearance.PropCycle.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Give materials a second life."
            android:textAppearance="@style/TextAppearance.PropCycle.Body"
            android:textColor="@color/pc_text_secondary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/primary_action"
        style="@style/Widget.PropCycle.Button.Dark"
        android:layout_width="88dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_lg"
        android:contentDescription="Continue to sign in"
        android:text="Go!" />

</FrameLayout>
