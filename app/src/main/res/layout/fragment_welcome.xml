<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_sky_blue"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_welcome_poster_panel"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="28dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="58dp">

                <View
                    android:layout_width="248dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_welcome_banner"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/fredoka_semibold"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:text="WELCOME"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/welcome_wordmark" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/welcome_hero_illustration"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/welcome_hero_illustration_description"
                    android:scaleType="centerInside"
                    android:src="@drawable/welcome_hero_illustration" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:text="Give materials a second life."
                android:textColor="@color/pc_brand_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary_action"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:contentDescription="@string/welcome_continue_description"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Go"
                android:textAllCaps="false"
                android:textColor="@color/pc_brand_surface"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pc_brand_primary_blue"
                app:cornerRadius="30dp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
