<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_sm">

        <TextView
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_result_details_material_label"
            android:textColor="@color/pc_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/details_material_value"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/pc_text_secondary" />

        <TextView
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ai_result_section_spacing"
            android:text="@string/ai_result_details_category_label"
            android:textColor="@color/pc_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/details_category_value"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/pc_text_secondary" />

        <TextView
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ai_result_section_spacing"
            android:text="@string/ai_result_details_recyclable_label"
            android:textColor="@color/pc_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/details_recyclable_value"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/pc_text_secondary" />

        <TextView
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ai_result_section_spacing"
            android:text="@string/ai_result_details_model_estimate_label"
            android:textColor="@color/pc_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/details_model_estimate_value"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/pc_text_secondary" />

        <TextView
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/ai_result_details_guidance_label"
            android:textColor="@color/pc_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/details_guidance_value"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/pc_text_secondary" />

        <TextView
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/ai_result_details_environment_label"
            android:textColor="@color/pc_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/details_environment_value"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/pc_text_secondary" />

        <TextView
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/ai_result_details_safety_label"
            android:textColor="@color/pc_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/details_safety_value"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/pc_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_ai_result_warning"
            android:orientation="vertical"
            android:padding="@dimen/ai_result_section_spacing">

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_result_details_disclaimer_label"
                android:textColor="@color/pc_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/details_disclaimer_value"
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/pc_text_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
