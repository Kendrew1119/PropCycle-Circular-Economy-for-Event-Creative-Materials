<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="92dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:includeFontPadding="false"
                android:text="Lend Out"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="36sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="1dp"
                android:text="Borrow useful equipment from the community or share your own."
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="88dp"
            android:layout_height="72dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/lend_out_share_icon" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_marketplace_search">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="14dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_marketplace_search" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/lending_search_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:hint="Search title or area"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="46dp"
            android:paddingEnd="14dp"
            android:textColor="@color/pc_brand_text_primary"
            android:textColorHint="@color/pc_brand_text_secondary"
            android:textSize="15sp" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/lending_filter_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/lending_filter_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true"
                android:fontFamily="@font/fredoka_semibold"
                android:includeFontPadding="false"
                android:text="All"
                android:textColor="@color/lending_filter_chip_text"
                android:textSize="14sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/lending_filter_chip_background"
                app:chipCornerRadius="22dp"
                app:chipEndPadding="14dp"
                app:chipMinHeight="32dp"
                app:chipStartPadding="14dp"
                app:chipStrokeColor="@color/lending_filter_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/lending_filter_equipment"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/fredoka_semibold"
                android:includeFontPadding="false"
                android:text="Equipment"
                android:textColor="@color/lending_filter_chip_text"
                android:textSize="14sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/lending_filter_chip_background"
                app:chipCornerRadius="22dp"
                app:chipEndPadding="14dp"
                app:chipMinHeight="32dp"
                app:chipStartPadding="14dp"
                app:chipStrokeColor="@color/lending_filter_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/lending_filter_tools"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/fredoka_semibold"
                android:includeFontPadding="false"
                android:text="Tools"
                android:textColor="@color/lending_filter_chip_text"
                android:textSize="14sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/lending_filter_chip_background"
                app:chipCornerRadius="22dp"
                app:chipEndPadding="14dp"
                app:chipMinHeight="32dp"
                app:chipStartPadding="14dp"
                app:chipStrokeColor="@color/lending_filter_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/lending_filter_electronics"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/fredoka_semibold"
                android:includeFontPadding="false"
                android:text="Electronics"
                android:textColor="@color/lending_filter_chip_text"
                android:textSize="14sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/lending_filter_chip_background"
                app:chipCornerRadius="22dp"
                app:chipEndPadding="14dp"
                app:chipMinHeight="32dp"
                app:chipStartPadding="14dp"
                app:chipStrokeColor="@color/lending_filter_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/lending_filter_event_gear"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/fredoka_semibold"
                android:includeFontPadding="false"
                android:text="@string/lending_category_event_gear"
                android:textColor="@color/lending_filter_chip_text"
                android:textSize="14sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/lending_filter_chip_background"
                app:chipCornerRadius="22dp"
                app:chipEndPadding="14dp"
                app:chipMinHeight="32dp"
                app:chipStartPadding="14dp"
                app:chipStrokeColor="@color/lending_filter_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/lending_filter_craft"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/fredoka_semibold"
                android:includeFontPadding="false"
                android:text="@string/lending_category_craft"
                android:textColor="@color/lending_filter_chip_text"
                android:textSize="14sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/lending_filter_chip_background"
                app:chipCornerRadius="22dp"
                app:chipEndPadding="14dp"
                app:chipMinHeight="32dp"
                app:chipStartPadding="14dp"
                app:chipStrokeColor="@color/lending_filter_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/lending_filter_other"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/fredoka_semibold"
                android:includeFontPadding="false"
                android:text="@string/lending_category_other"
                android:textColor="@color/lending_filter_chip_text"
                android:textSize="14sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/lending_filter_chip_background"
                app:chipCornerRadius="22dp"
                app:chipEndPadding="14dp"
                app:chipMinHeight="32dp"
                app:chipStartPadding="14dp"
                app:chipStrokeColor="@color/lending_filter_chip_stroke"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/create_lending_action"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/fredoka_semibold"
        android:text="+  Lend an item"
        android:textAllCaps="false"
        android:textColor="@color/pc_brand_surface"
        android:textSize="16sp"
        app:backgroundTint="@color/pc_brand_primary_blue"
        app:cornerRadius="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lending_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_lending_map_segment"
            android:orientation="horizontal"
            android:padding="1dp">

            <TextView
                android:id="@+id/lending_list_map_action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_lending_list_segment_map"
                android:clickable="true"
                android:contentDescription="@string/lending_list_open_map_description"
                android:drawableStart="@drawable/ic_lending_map_map"
                android:drawablePadding="4dp"
                android:drawableTint="@color/pc_brand_deep_blue"
                android:focusable="true"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/lending_map_map"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_lending_list_segment_selected"
                android:drawableStart="@drawable/ic_lending_map_list"
                android:drawablePadding="4dp"
                android:drawableTint="@color/pc_on_primary"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/lending_map_list"
                android:textColor="@color/pc_on_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lending_item_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />

        <ProgressBar
            android:id="@+id/lending_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/lending_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="14dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="20dp"
            android:text="No available lending items match this search.&#10;Try another category or lend an item."
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            app:drawableTopCompat="@drawable/ic_material_box" />
    </FrameLayout>
</LinearLayout>
