<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_horizontal">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.PropCycle.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/thread_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_circle_gray"
            android:contentDescription="Marketplace conversation avatar"
            android:gravity="center"
            android:text="P"
            android:textColor="@color/pc_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/context_title"
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Conversation"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/context_caption"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marketplace listing" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pc_surface_mid" />

    <TextView
        android:id="@+id/status_text"
        style="@style/TextAppearance.PropCycle.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_horizontal"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_horizontal"
        android:background="@drawable/bg_card_light"
        android:padding="@dimen/space_sm"
        android:textColor="@color/pc_ink"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_lg"
        android:contentDescription="Loading messages" />

    <TextView
        android:id="@+id/empty_text"
        style="@style/TextAppearance.PropCycle.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:padding="@dimen/space_lg"
        android:text="No messages yet. Start the conversation."
        android:textAlignment="center"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="@dimen/space_sm"
        android:scrollbars="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pc_surface_mid" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingEnd="@dimen/screen_horizontal">

        <EditText
            android:id="@+id/message_composer"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:hint="Type a message..."
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:maxLines="3"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/pc_ink"
            android:textColorHint="@color/pc_text_secondary"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/primary_action"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/send"
            android:padding="15dp"
            android:src="@drawable/ic_send"
            app:tint="@color/pc_white" />
    </LinearLayout>
</LinearLayout>
