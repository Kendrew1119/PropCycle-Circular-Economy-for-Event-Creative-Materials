<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_conversation_back"
            android:contentDescription="@string/back"
            android:padding="13dp"
            android:src="@drawable/ic_back"
            app:tint="@color/pc_brand_deep_blue" />

        <TextView
            android:id="@+id/thread_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="60dp"
            android:background="@drawable/bg_conversation_avatar"
            android:contentDescription="Marketplace conversation avatar"
            android:fontFamily="@font/fredoka_semibold"
            android:gravity="center"
            android:text="P"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="19sp"
            tools:text="A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="120dp"
            android:layout_marginEnd="56dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/context_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/fredoka_semibold"
                android:maxLines="1"
                android:text="Conversation"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="19sp"
                tools:text="Event fabric bundle" />

            <TextView
                android:id="@+id/context_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Marketplace listing"
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_send"
            app:tint="@color/pc_brand_primary_blue" />
    </FrameLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_conversation_status"
        android:padding="12dp"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="14sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="Loading messages"
            android:indeterminateTint="@color/pc_brand_primary_blue" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_conversation_empty"
            android:fontFamily="@font/fredoka_semibold"
            android:gravity="center"
            android:padding="28dp"
            android:text="No messages yet. Start the conversation."
            android:textAlignment="center"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="17sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            tools:itemCount="4"
            tools:listitem="@layout/item_chat_message" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/pc_brand_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <EditText
            android:id="@+id/message_composer"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_conversation_composer"
            android:hint="Type a message..."
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:maxLines="3"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/pc_brand_text_primary"
            android:textColorHint="@color/pc_brand_text_secondary"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/primary_action"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_conversation_send"
            android:contentDescription="@string/send"
            android:padding="14dp"
            android:src="@drawable/ic_send"
            app:tint="@color/pc_white" />
    </LinearLayout>
</LinearLayout>
