<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/listing_card"
    android:layout_width="match_parent"
    android:layout_height="224dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/pc_brand_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/pc_brand_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="122dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/pc_brand_soft_blue"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_marketplace_photo_placeholder">

                <ImageView
                    android:id="@+id/listing_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Marketplace item photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

        <TextView
            android:id="@+id/listing_image_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Marketplace item image placeholder"
            android:drawableTop="@drawable/ic_marketplace_placeholder_box"
            android:drawablePadding="6dp"
            android:fontFamily="@font/fredoka_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="4dp"
            android:text="ITEM"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/listing_image_progress"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/pc_brand_primary_blue"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/listing_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/fredoka_semibold"
            android:maxLines="1"
            android:textColor="@color/pc_brand_text_primary"
            android:textSize="15sp"
            tools:text="Reusable event banner" />

        <TextView
            android:id="@+id/listing_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_marketplace_meta"
            android:ellipsize="end"
            android:fontFamily="@font/fredoka_semibold"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="11sp"
            tools:text="Exchange | Decoration" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
