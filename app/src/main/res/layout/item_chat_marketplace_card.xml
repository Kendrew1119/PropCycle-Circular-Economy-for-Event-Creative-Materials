<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/pc_brand_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pc_brand_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_marketplace_photo_placeholder">

                <ImageView
                    android:id="@+id/marketplace_item_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Marketplace item photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/marketplace_item_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Marketplace item image placeholder"
                    android:drawableTop="@drawable/ic_marketplace_placeholder_box"
                    android:drawablePadding="4dp"
                    android:fontFamily="@font/fredoka_semibold"
                    android:gravity="center"
                    android:text="ITEM"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/marketplace_item_image_progress"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/pc_brand_primary_blue"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/marketplace_item_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/fredoka_semibold"
                    android:maxLines="2"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="17sp"
                    tools:text="Reusable event banner" />

                <TextView
                    android:id="@+id/marketplace_item_offer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp"
                    tools:text="For sale · RM 25.00" />

                <TextView
                    android:id="@+id/marketplace_item_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_marketplace_meta"
                    android:fontFamily="@font/fredoka_semibold"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="12sp"
                    tools:text="Available" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_marketplace_item_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="View Item Details"
            android:textAllCaps="false"
            android:textColor="@color/pc_white"
            android:textSize="15sp"
            app:backgroundTint="@color/pc_brand_primary_blue"
            app:cornerRadius="14dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
