<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/page_header_height">
        <TextView
            android:id="@+id/lending_map_page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_semibold"
            android:includeFontPadding="false"
            android:text="@string/lending_map_title"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="@dimen/page_header_title_size"
            app:layout_constraintEnd_toStartOf="@id/lending_map_title_doodle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/lending_map_page_subtitle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />
        <TextView
            android:id="@+id/lending_map_page_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/lending_map_subtitle"
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="@dimen/page_header_subtitle_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/lending_map_title_doodle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lending_map_page_title" />
        <ImageView
            android:id="@+id/lending_map_title_doodle"
            android:layout_width="@dimen/page_header_icon_size"
            android:layout_height="@dimen/page_header_icon_size"
            android:contentDescription="@string/lending_map_title_doodle_description"
            android:src="@drawable/ic_recycle_location_doodle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/page_top_card_height"
        android:layout_marginTop="@dimen/page_top_card_margin"
        app:cardBackgroundColor="@color/pc_brand_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/pc_brand_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_top_card_horizontal_padding"
            android:paddingTop="@dimen/page_top_card_vertical_padding"
            android:paddingEnd="@dimen/page_top_card_horizontal_padding"
            android:paddingBottom="@dimen/page_top_card_vertical_padding">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/page_top_control_height"
                android:background="@drawable/bg_marketplace_search">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_marketplace_search" />

                <EditText
                    android:id="@+id/lending_map_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="@string/lending_map_search_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="42dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textColorHint="@color/pc_brand_text_secondary"
                    android:textSize="14sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/page_top_control_height"
                android:layout_marginTop="@dimen/page_top_control_spacing"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lending_map_location_action"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:fontFamily="@font/fredoka_semibold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:paddingStart="8dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="0dp"
                    android:singleLine="true"
                    android:text="@string/lending_map_near_me"
                    android:textAllCaps="false"
                    android:textColor="@color/pc_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/pc_lending_map_near_me_surface"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_lending_map_near_me"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/pc_primary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="@dimen/page_top_control_height"
                    android:background="@drawable/bg_lending_map_segment"
                    android:orientation="horizontal"
                    android:padding="1dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lending_map_segment_selected"
                        android:drawableStart="@drawable/ic_lending_map_map"
                        android:drawablePadding="2dp"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/lending_map_map"
                        android:textColor="@color/pc_on_primary"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/lending_map_list_action"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lending_map_segment_list"
                        android:clickable="true"
                        android:contentDescription="@string/lending_map_open_list_description"
                        android:drawableStart="@drawable/ic_lending_map_list"
                        android:drawablePadding="2dp"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/lending_map_list"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lending_map_category_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/page_top_control_height"
                android:layout_marginTop="@dimen/page_top_control_spacing"
                android:gravity="start|center_vertical"
                android:drawableEnd="@drawable/ic_lending_map_chevron_down"
                android:fontFamily="@font/fredoka_semibold"
                android:drawablePadding="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="@dimen/page_top_control_height"
                android:paddingStart="12dp"
                android:paddingTop="0dp"
                android:paddingEnd="12dp"
                android:paddingBottom="0dp"
                android:text="@string/lending_category_filter_all"
                android:textAllCaps="false"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="13sp"
                app:backgroundTint="@color/pc_brand_surface"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_lending_map_category"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/pc_brand_deep_blue"
                app:strokeColor="@color/pc_lending_map_soft_border"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/lending_map_container"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_lending_map_container"
        android:clipToOutline="true"
        android:elevation="2dp" />

    <TextView
        android:id="@+id/lending_map_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_lending_map_status"
        android:drawableStart="@drawable/ic_recycle_info"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/pc_brand_deep_blue"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lending_map_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
