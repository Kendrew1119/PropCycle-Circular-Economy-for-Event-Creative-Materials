<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/pc_surface_mid"
            android:contentDescription="Static lending map preview">

            <TextView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_white"
                android:gravity="center"
                android:text="MAP"
                android:textColor="@color/pc_text_secondary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="56dp"
                android:layout_height="72dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="90dp"
                android:layout_marginTop="190dp"
                android:contentDescription="Lending listing pin one"
                android:gravity="center"
                android:text="●\n▼"
                android:textColor="@color/pc_ink"
                android:textSize="24sp" />

            <TextView
                android:layout_width="56dp"
                android:layout_height="72dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="285dp"
                android:layout_marginEnd="78dp"
                android:contentDescription="Lending listing pin two"
                android:gravity="center"
                android:text="●\n▼"
                android:textColor="@color/pc_ink"
                android:textSize="24sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pc_background"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/screen_horizontal"
            android:paddingBottom="@dimen/space_lg">

            <LinearLayout
                android:id="@+id/item_card"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:background="@drawable/bg_card_gray"
                android:clickable="true"
                android:contentDescription="View first nearby lending resource"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_card_light"
                    android:gravity="center"
                    android:text="01"
                    android:textColor="@color/pc_text_secondary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.PropCycle.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Event Display Stand"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.PropCycle.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="0.8 km away  •  Available" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/item_card_secondary"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_light"
                android:clickable="true"
                android:contentDescription="View second nearby lending resource"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_card_gray"
                    android:gravity="center"
                    android:text="02"
                    android:textColor="@color/pc_text_secondary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.PropCycle.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reusable Photo Backdrop"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.PropCycle.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="1.4 km away  •  Available" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/screen_horizontal"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/screen_horizontal"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Search"
            android:src="@drawable/ic_search"
            app:tint="@color/pc_ink" />

        <TextView
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Search recycle bins &amp; listing"
            android:textColor="@color/pc_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
