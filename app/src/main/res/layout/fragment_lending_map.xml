<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/screen_horizontal"
    android:paddingBottom="@dimen/space_md">

    <TextView
        style="@style/TextAppearance.PropCycle.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available items nearby" />

    <TextView
        style="@style/TextAppearance.PropCycle.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="Search community items first. Locations are approximate; confirm the meeting point in chat."
        android:textColor="@color/pc_text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/lending_map_search_input"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:hint="Search title or area"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lending_map_location_action"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="Near me" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lending_map_list_action"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="List" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/lending_map_category_action"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="@string/lending_category_filter_all" />

    <FrameLayout
        android:id="@+id/lending_map_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1.15"
        android:background="@drawable/bg_card_light" />

    <TextView
        android:id="@+id/lending_map_status"
        style="@style/TextAppearance.PropCycle.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textColor="@color/pc_text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lending_map_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="0.85"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_md" />
</LinearLayout>
