<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="52dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="-10dp"
        android:layout_marginTop="112dp"
        android:alpha="0.18"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_tag" />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="54dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="190dp"
        android:layout_marginEnd="-3dp"
        android:alpha="0.16"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_bottle" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="22dp"
        android:alpha="0.34"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_recent_sparkle" />

    <ImageView
        android:layout_width="70dp"
        android:layout_height="52dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="-14dp"
        android:layout_marginBottom="18dp"
        android:alpha="0.16"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_fabric_roll" />

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="-8dp"
        android:layout_marginBottom="2dp"
        android:alpha="0.14"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_box" />

    <ImageView
        android:layout_width="54dp"
        android:layout_height="34dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-12dp"
        android:alpha="0.22"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_recent_squiggle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back_button"
                style="@style/Widget.PropCycle.IconButton"
                android:background="@drawable/bg_recent_back_button"
                android:contentDescription="@string/back"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                app:tint="@color/pc_brand_deep_blue" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:text="@string/home_recent_title"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/recent_activity_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_recent_empty_state"
            android:elevation="2dp"
            android:gravity="center"
            android:minHeight="128dp"
            android:padding="20dp"
            android:text="@string/recent_activity_empty"
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recent_activity_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />
    </LinearLayout>
</FrameLayout>