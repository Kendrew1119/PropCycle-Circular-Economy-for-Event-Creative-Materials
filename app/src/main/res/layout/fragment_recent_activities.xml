<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="@dimen/screen_vertical"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="@dimen/space_xl">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.PropCycle.IconButton"
            android:contentDescription="Go back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_lg"
            android:text="Recent Activities"
            android:textAppearance="@style/TextAppearance.PropCycle.Display" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_card_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_card_dark"
                android:contentDescription="Scan activity"
                android:gravity="center"
                android:text="♻"
                android:textColor="@color/pc_white"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PET bottle scanned"
                    android:textAppearance="@style/TextAppearance.PropCycle.Title"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Identified as recyclable plastic"
                    android:textAppearance="@style/TextAppearance.PropCycle.Caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_card_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_card_dark"
                android:contentDescription="Marketplace activity"
                android:gravity="center"
                android:text="↗"
                android:textColor="@color/pc_white"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Listing published"
                    android:textAppearance="@style/TextAppearance.PropCycle.Title"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Cardboard display panels"
                    android:textAppearance="@style/TextAppearance.PropCycle.Caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_card_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_card_dark"
                android:contentDescription="Lending activity"
                android:gravity="center"
                android:text="⇄"
                android:textColor="@color/pc_white"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resource lent out"
                    android:textAppearance="@style/TextAppearance.PropCycle.Title"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Portable lighting kit"
                    android:textAppearance="@style/TextAppearance.PropCycle.Caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:background="@drawable/bg_card_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_card_dark"
                android:contentDescription="Recycle center activity"
                android:gravity="center"
                android:text="⌖"
                android:textColor="@color/pc_white"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recycle point saved"
                    android:textAppearance="@style/TextAppearance.PropCycle.Title"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Community recycling hub"
                    android:textAppearance="@style/TextAppearance.PropCycle.Caption" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</ScrollView>
