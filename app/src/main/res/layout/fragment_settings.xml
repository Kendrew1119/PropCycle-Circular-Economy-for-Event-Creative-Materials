<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/menu_button"
                style="@style/Widget.PropCycle.IconButton"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_menu" />

            <TextView
                style="@style/TextAppearance.PropCycle.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_card_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_md">

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dark Theme"
                android:textStyle="bold" />

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:checked="false"
                android:contentDescription="Dark Theme, off"
                android:minWidth="@dimen/touch_target"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_md">

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Push Notifications"
                android:textStyle="bold" />

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:checked="true"
                android:contentDescription="Push Notifications, on"
                android:minWidth="@dimen/touch_target"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_md">

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Location"
                android:textStyle="bold" />

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:checked="true"
                android:contentDescription="Location, on"
                android:minWidth="@dimen/touch_target"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_gray"
            android:clickable="true"
            android:contentDescription="Open Account Details"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg">

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Account Details"
                android:textStyle="bold" />

            <TextView
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/pc_ink"
                android:textSize="28sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_light"
            android:clickable="true"
            android:contentDescription="Open second Account Details entry"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg">

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Account Details"
                android:textStyle="bold" />

            <TextView
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/pc_ink"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
