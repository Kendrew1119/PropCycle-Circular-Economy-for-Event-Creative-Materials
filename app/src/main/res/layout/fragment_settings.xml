<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="126dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginEnd="104dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka_semibold"
                    android:text="Settings"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="A few practical details, clearly explained."
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:layout_gravity="end|bottom"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings_doodles" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="APP EXPERIENCE"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_section"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/dark_theme_setting"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon_yellow"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_eco_bulb"
                    app:tint="@color/pc_brand_deep_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="Dark theme"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Not available in this light-only release"
                        android:textColor="@color/pc_brand_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/dark_theme_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:checked="false"
                    android:contentDescription="Dark Theme, off"
                    android:enabled="false"
                    android:minWidth="48dp"
                    android:showText="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="74dp"
                android:background="@color/pc_brand_outline" />

            <LinearLayout
                android:id="@+id/push_notification_setting"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon_blue"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/pc_brand_deep_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="Phone push updates"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Unavailable — updates stay in the app"
                        android:textColor="@color/pc_brand_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/push_notifications_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:checked="false"
                    android:contentDescription="Push Notifications, unavailable"
                    android:enabled="false"
                    android:minWidth="48dp"
                    android:showText="false" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="ACCOUNT &amp; DATA"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_section"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/location_setting"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:clickable="true"
                android:contentDescription="Manage Android location permission"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon_green"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/pc_brand_surface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="Location"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Manage Android permission"
                        android:textColor="@color/pc_brand_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/location_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:checked="false"
                    android:clickable="false"
                    android:contentDescription="Location permission status"
                    android:focusable="false"
                    android:minWidth="48dp"
                    android:showText="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="74dp"
                android:background="@color/pc_brand_outline" />

            <LinearLayout
                android:id="@+id/account_details_action"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:clickable="true"
                android:contentDescription="Open Account Details"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon_blue"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/pc_brand_deep_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="Account details"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Open your PropCycle profile"
                        android:textColor="@color/pc_brand_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="30sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="74dp"
                android:background="@color/pc_brand_outline" />

            <LinearLayout
                android:id="@+id/clear_history_action"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:clickable="true"
                android:contentDescription="Clear this account's activity history on this device"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon_yellow"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/pc_brand_deep_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="Clear local activity"
                        android:textColor="@color/pc_brand_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Only clears history stored on this device"
                        android:textColor="@color/pc_brand_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="30sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
