<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_canvas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/screen_horizontal"
            android:paddingBottom="@dimen/space_lg">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="112dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingEnd="76dp">

                    <TextView
                        android:id="@+id/home_greeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="2"
                        android:text="Hey HuiMin,"
                        android:textColor="@color/pc_text_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/home_greeting_support"
                        android:textColor="@color/pc_text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|end"
                    android:alpha="0.18"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_material_box" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="46dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.16"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_material_bottle" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_overview_rich"
                android:elevation="4dp"
                android:minHeight="156dp"
                android:outlineProvider="background"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:alpha="0.14"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_material_fabric_roll" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:alpha="0.14"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_material_can" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="24dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_home_overview_icon"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_welcome_recycle"
                            app:tint="@color/pc_on_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_overview_title"
                            android:textColor="@color/pc_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:lineSpacingMultiplier="1.12"
                            android:text="@string/home_overview_body"
                            android:textColor="@color/pc_text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/home_overview_summary"
                            android:textColor="@color/pc_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/home_search_action"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_search"
                android:clickable="true"
                android:contentDescription="Search marketplace or lending items"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:outlineProvider="background"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="@string/home_search_hint"
                    android:textAppearance="@style/TextAppearance.PropCycle.Body"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="16sp" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/scanner_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_scanner_card"
                android:clickable="true"
                android:contentDescription="@string/home_scanner_open"
                android:elevation="4dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="128dp"
                android:orientation="horizontal"
                android:outlineProvider="background"
                android:padding="@dimen/space_md">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_home_icon_sage"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/scan_frame" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/home_scanner_title"
                        android:textColor="@color/pc_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:importantForAccessibility="no"
                        android:lineSpacingMultiplier="1.12"
                        android:text="@string/home_scanner_description"
                        android:textColor="@color/pc_text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:rotation="180"
                    android:src="@drawable/ic_back"
                    app:tint="@color/pc_accent" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_quick_actions_title"
                    android:textColor="@color/pc_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="34dp"
                    android:layout_gravity="end|center_vertical"
                    android:alpha="0.16"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_material_tag" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/home_recycle_action"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_action_card"
                    android:clickable="true"
                    android:contentDescription="@string/home_quick_recycle"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:outlineProvider="background"
                    android:paddingStart="4dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_home_icon_green"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_welcome_recycle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:maxLines="2"
                        android:minLines="2"
                        android:text="@string/home_quick_recycle"
                        android:textColor="@color/pc_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/ic_back"
                        app:tint="@color/pc_accent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/home_create_listing_action"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_action_card"
                    android:clickable="true"
                    android:contentDescription="@string/home_quick_create_listing"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:outlineProvider="background"
                    android:paddingStart="4dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_home_icon_orange"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/pc_accent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:maxLines="2"
                        android:minLines="2"
                        android:text="@string/home_quick_create_listing"
                        android:textColor="@color/pc_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/ic_back"
                        app:tint="@color/pc_accent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/home_lend_resource_action"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_action_card"
                    android:clickable="true"
                    android:contentDescription="@string/home_quick_lend_resource"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:outlineProvider="background"
                    android:paddingStart="4dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_home_icon_sage"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_welcome_exchange" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:maxLines="2"
                        android:minLines="2"
                        android:text="@string/home_quick_lend_resource"
                        android:textColor="@color/pc_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/ic_back"
                        app:tint="@color/pc_accent" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/home_impact_title"
                android:textColor="@color/pc_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_home_impact_rich"
                android:elevation="3dp"
                android:outlineProvider="background"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="42dp"
                    android:layout_gravity="bottom|end"
                    android:alpha="0.12"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_material_pallet" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="@string/home_impact_reused_empty"
                            android:gravity="center"
                            android:importantForAccessibility="yes"
                            android:orientation="vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_home_icon_sage"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:padding="10dp"
                                android:src="@drawable/ic_material_box" />

                            <TextView
                                android:id="@+id/home_reused_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:importantForAccessibility="no"
                                android:text="@string/home_impact_empty_value"
                                android:textColor="@color/pc_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/home_lent_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                android:text="@string/home_impact_reused"
                                android:textColor="@color/pc_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="72dp"
                            android:alpha="0.20"
                            android:background="@color/pc_outline"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="@string/home_impact_lent_empty"
                            android:gravity="center"
                            android:importantForAccessibility="yes"
                            android:orientation="vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_home_icon_orange"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:padding="10dp"
                                android:src="@drawable/ic_welcome_exchange"
                                app:tint="@color/pc_accent" />

                            <TextView
                                android:id="@+id/home_scanned_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:importantForAccessibility="no"
                                android:text="@string/home_impact_empty_value"
                                android:textColor="@color/pc_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/home_scanned_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                android:text="@string/home_impact_lent"
                                android:textColor="@color/pc_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="72dp"
                            android:alpha="0.20"
                            android:background="@color/pc_outline"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="@string/home_impact_recycled_empty"
                            android:gravity="center"
                            android:importantForAccessibility="yes"
                            android:orientation="vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_home_icon_green"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:padding="10dp"
                                android:src="@drawable/ic_welcome_recycle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:importantForAccessibility="no"
                                android:text="@string/home_impact_empty_value"
                                android:textColor="@color/pc_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                android:text="Scanned"
                                android:textColor="@color/pc_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/pc_primary_container"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/home_impact_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/home_impact_empty_message"
                        android:textColor="@color/pc_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/home_recent_title"
                android:textColor="@color/pc_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
            <FrameLayout
                android:id="@+id/recent_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_home_recent_warm"
                android:clickable="true"
                android:contentDescription="@string/home_recent_view_all"
                android:elevation="2dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:minHeight="56dp"
                android:outlineProvider="background"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="@dimen/space_md"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_history"
                    app:tint="@color/pc_accent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="2"
                    android:paddingStart="@dimen/space_2xl"
                    android:paddingEnd="@dimen/space_2xl"
                    android:text="@string/home_recent_view_all"
                    android:textColor="@color/pc_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/space_md"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:rotation="180"
                    android:src="@drawable/ic_back"
                    app:tint="@color/pc_accent" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_home_eco_warm"
                android:elevation="2dp"
                android:minHeight="120dp"
                android:outlineProvider="background"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|bottom"
                    android:alpha="0.16"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_material_tag" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="38dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_home_icon_orange"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_eco_bulb" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_eco_tip_title"
                            android:textColor="@color/pc_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
