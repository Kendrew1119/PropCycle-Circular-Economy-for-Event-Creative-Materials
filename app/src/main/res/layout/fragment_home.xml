<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_greeting_min_height"
                android:background="@color/pc_brand_deep_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/home_screen_horizontal"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.05"
                        android:orientation="vertical"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/home_greeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:maxLines="2"
                            android:text="Hey there,"
                            android:textColor="@color/pc_on_primary"
                            android:textSize="@dimen/home_greeting_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/home_greeting_support_gap"
                            android:lineSpacingMultiplier="1.08"
                            android:text="@string/home_greeting_support"
                            android:textColor="@color/pc_on_primary"
                            android:textSize="@dimen/home_greeting_support_size" />

                        <View
                            android:layout_width="72dp"
                            android:layout_height="4dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/bg_home_hero_underline"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="126dp"
                        android:layout_weight="0.95"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="2dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/home_recycling_box" />
                </LinearLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/home_hero_wave" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/home_screen_horizontal"
                android:paddingEnd="@dimen/home_screen_horizontal"
                android:paddingBottom="@dimen/home_content_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_overview_rich"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/home_overview_min_height"
                    android:orientation="horizontal"
                    android:outlineProvider="background"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_overview_title"
                            android:textColor="@color/pc_on_primary"
                            android:textSize="@dimen/home_overview_title_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.12"
                            android:maxLines="4"
                            android:text="@string/home_overview_body"
                            android:textColor="@color/pc_on_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="84dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/home_overview_globe" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/home_search_action"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_search_height"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_home_search"
                    android:clickable="true"
                    android:contentDescription="Search marketplace or lending items"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineProvider="background"
                    android:paddingStart="16dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="@dimen/home_search_icon_size"
                        android:layout_height="@dimen/home_search_icon_size"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/pc_brand_deep_blue" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:text="@string/home_search_hint"
                        android:textColor="@color/pc_brand_text_secondary"
                        android:textSize="@dimen/home_search_text_size" />

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/scan_frame"
                        app:tint="@color/pc_brand_deep_blue" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/home_recycle_action"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/home_quick_action_height"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_action_recycle"
                        android:clickable="true"
                        android:contentDescription="@string/home_quick_recycle"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:outlineProvider="background"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="52dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/home_action_recycle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:maxLines="2"
                            android:minLines="2"
                            android:text="@string/home_quick_recycle"
                            android:textColor="@color/pc_brand_deep_blue"
                            android:textSize="@dimen/home_quick_label_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:maxLines="2"
                            android:minLines="2"
                            android:text="@string/home_quick_recycle_body"
                            android:textColor="@color/pc_brand_text_secondary"
                            android:textSize="10sp" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_home_action_arrow_green"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:rotation="180"
                            android:src="@drawable/ic_back"
                            app:tint="@color/pc_on_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/home_create_listing_action"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/home_quick_action_height"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_action_listing"
                        android:clickable="true"
                        android:contentDescription="@string/home_quick_create_listing"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:outlineProvider="background"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="52dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/home_action_listing_tag" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:maxLines="2"
                            android:minLines="2"
                            android:text="@string/home_quick_create_listing"
                            android:textColor="@color/pc_brand_deep_blue"
                            android:textSize="@dimen/home_quick_label_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:maxLines="2"
                            android:minLines="2"
                            android:text="@string/home_quick_create_body"
                            android:textColor="@color/pc_brand_text_secondary"
                            android:textSize="10sp" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_home_action_arrow_yellow"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:rotation="180"
                            android:src="@drawable/ic_back"
                            app:tint="@color/pc_brand_deep_blue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/home_lend_resource_action"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/home_quick_action_height"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_action_lend"
                        android:clickable="true"
                        android:contentDescription="@string/home_quick_lend_resource"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:outlineProvider="background"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="52dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/home_action_lend" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:maxLines="2"
                            android:minLines="2"
                            android:text="@string/home_quick_lend_resource"
                            android:textColor="@color/pc_brand_deep_blue"
                            android:textSize="@dimen/home_quick_label_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:maxLines="2"
                            android:minLines="2"
                            android:text="@string/home_quick_lend_body"
                            android:textColor="@color/pc_brand_text_secondary"
                            android:textSize="10sp" />

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_home_action_arrow_blue"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:rotation="180"
                            android:src="@drawable/ic_back"
                            app:tint="@color/pc_on_primary" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/scanner_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_home_scanner_card"
                    android:clickable="true"
                    android:contentDescription="@string/home_scanner_open"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/home_scanner_min_height"
                    android:orientation="horizontal"
                    android:outlineProvider="background"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="56dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/home_ai_scanner" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_scanner_title"
                            android:textColor="@color/pc_on_primary"
                            android:textSize="@dimen/home_scanner_title_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingMultiplier="1.05"
                            android:maxLines="3"
                            android:text="@string/home_scanner_description"
                            android:textColor="@color/pc_on_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_home_scan_now"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:maxLines="2"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="@string/home_scanner_scan_now"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/home_impact_title"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="@dimen/home_section_title_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_home_impact_rich"
                    android:elevation="2dp"
                    android:minHeight="@dimen/home_impact_min_height"
                    android:orientation="vertical"
                    android:outlineProvider="background"
                    android:paddingStart="10dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="86dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_home_icon_green"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:padding="8dp"
                                android:src="@drawable/ic_material_box" />

                            <TextView
                                android:id="@+id/home_reused_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/home_impact_empty_value"
                                android:textColor="@color/pc_brand_eco_green"
                                android:textSize="@dimen/home_impact_value_size"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_impact_shared"
                                android:textColor="@color/pc_brand_text_primary"
                                android:textSize="@dimen/home_impact_label_size"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="56dp"
                            android:background="@color/pc_home_card_border"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_home_icon_orange"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:padding="8dp"
                                android:src="@drawable/ic_bottom_nav_lend_out"
                                app:tint="@color/pc_brand_deep_blue" />

                            <TextView
                                android:id="@+id/home_lent_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/home_impact_empty_value"
                                android:textColor="@color/pc_brand_deep_blue"
                                android:textSize="@dimen/home_impact_value_size"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_impact_lent"
                                android:textColor="@color/pc_brand_text_primary"
                                android:textSize="@dimen/home_impact_label_size"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="56dp"
                            android:background="@color/pc_home_card_border"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_home_icon_sage"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:padding="8dp"
                                android:src="@drawable/scan_frame"
                                app:tint="@color/pc_brand_deep_blue" />

                            <TextView
                                android:id="@+id/home_scanned_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/home_impact_empty_value"
                                android:textColor="@color/pc_brand_deep_blue"
                                android:textSize="@dimen/home_impact_value_size"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_impact_scanned"
                                android:textColor="@color/pc_brand_text_primary"
                                android:textSize="@dimen/home_impact_label_size"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/pc_home_card_border"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/home_impact_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/home_impact_empty_message"
                        android:textColor="@color/pc_brand_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/home_recent_title"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="@dimen/home_section_title_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/recent_action"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_recent_height"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_home_recent_warm"
                    android:clickable="true"
                    android:contentDescription="@string/home_recent_view_all"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineProvider="background"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_home_icon_sage"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/pc_brand_deep_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/home_recent_preview_title"
                            android:textColor="@color/pc_brand_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/home_recent_preview_empty"
                            android:textColor="@color/pc_brand_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="76dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_home_recent_action"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:maxLines="2"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/home_recent_view_all_short"
