<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="@dimen/space_2xl"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="@dimen/space_xl">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Join XX"
                android:textAppearance="@style/TextAppearance.PropCycle.Display" />

            <ImageButton
                android:id="@+id/close_button"
                style="@style/Widget.PropCycle.IconButton"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Close registration"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="Create an account to scan, share, and recycle."
            android:textAppearance="@style/TextAppearance.PropCycle.Body" />

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_xl"
            android:background="@drawable/bg_circle_gray"
            android:contentDescription="Profile image placeholder"
            android:padding="24dp"
            android:src="@drawable/ic_person" />

        <EditText
            android:id="@+id/display_name_input"
            style="@style/Widget.PropCycle.Field"
            android:layout_marginBottom="@dimen/space_md"
            android:autofillHints="name"
            android:hint="Full Name"
            android:importantForAutofill="yes"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <EditText
            android:id="@+id/email_input"
            style="@style/Widget.PropCycle.Field"
            android:layout_marginBottom="@dimen/space_md"
            android:autofillHints="emailAddress"
            android:hint="Email"
            android:importantForAutofill="yes"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:maxLines="1" />

        <EditText
            android:id="@+id/password_input"
            style="@style/Widget.PropCycle.Field"
            android:layout_marginBottom="@dimen/space_md"
            android:autofillHints="newPassword"
            android:hint="Password"
            android:importantForAutofill="yes"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1" />

        <TextView
            android:id="@+id/auth_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PropCycle.Caption"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary_action"
                style="@style/Widget.PropCycle.Button.Dark"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Register" />

            <ProgressBar
                android:id="@+id/auth_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/pc_white"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/secondary_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Already have an account?  Sign In"
            android:textAppearance="@style/TextAppearance.PropCycle.Caption"
            android:textColor="@color/pc_ink" />
    </LinearLayout>

</ScrollView>
