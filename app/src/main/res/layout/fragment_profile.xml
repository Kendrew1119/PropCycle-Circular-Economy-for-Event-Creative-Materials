<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@drawable/bg_profile_header"
            android:padding="16dp">

            <TextView
                android:id="@+id/profile_header_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:text="MY PROFILE"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="100dp"
                android:layout_height="108dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:src="@drawable/pc_sticker_profile_boxes" />

            <TextView
                android:id="@+id/profile_avatar_initial"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="start|top"
                android:layout_marginTop="46dp"
                android:background="@drawable/bg_profile_avatar"
                android:contentDescription="User profile picture"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:text="U"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_marginStart="78dp"
                android:layout_marginTop="51dp"
                android:layout_marginEnd="96dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/fredoka_semibold"
                    android:maxLines="1"
                    android:text="User Name"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_edit_action"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_profile_edit"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Edit display name"
            android:textColor="@color/pc_brand_deep_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_profile_summary"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/profile_activity_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:text="YOUR ACTIVITY"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/profile_activity_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/fredoka_semibold"
                android:text="No recorded activity yet"
                android:textColor="@color/pc_brand_text_primary"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/profile_member_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="PropCycle member"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/profile_rating_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RatingBar
                    android:id="@+id/profile_rating_bar"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:rating="0"
                    android:stepSize="0.1" />

                <TextView
                    android:id="@+id/profile_rating_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="No marketplace ratings yet"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/profile_listings_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="MY LISTINGS"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/item_card"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_profile_listing"
            android:clickable="true"
            android:contentDescription="Open my active marketplace listing"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/bg_profile_listing_icon"
                android:contentDescription="@null"
                android:padding="17dp"
                android:src="@drawable/ic_material_box"
                app:tint="@color/pc_brand_deep_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_listing_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/fredoka_semibold"
                    android:maxLines="2"
                    android:text="No active marketplace listings"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/profile_listing_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:text="Tap to create one"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="30sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logout_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/profile_logout"
            android:textAllCaps="false"
            android:textColor="@color/pc_brand_accent_red"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pc_brand_surface"
            app:cornerRadius="24dp"
            app:strokeColor="@color/pc_brand_accent_red"
            app:strokeWidth="2dp" />
    </LinearLayout>
</ScrollView>
