<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@drawable/bg_profile_header"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:id="@+id/profile_header_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:text="MY PROFILE"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="86dp"
                android:layout_height="92dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/pc_sticker_profile_boxes" />

            <FrameLayout
                android:id="@+id/profile_avatar_container"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_profile_avatar"
                android:clickable="true"
                android:clipChildren="true"
                android:clipToOutline="true"
                android:contentDescription="User profile picture"
                android:focusable="true">

                <TextView
                    android:id="@+id/profile_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/fredoka_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="U"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="26sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/profile_avatar_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="110dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/fredoka_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="User Name"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_identity_action_row"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_avatar_action"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_profile_edit"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Choose avatar"
                    android:textAllCaps="false"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_edit_action"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_profile_edit"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Edit name"
                    android:textAllCaps="false"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/profile_activity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="AT A GLANCE"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_summary"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="LOCAL ACTIVITY"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="10sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_recent_sparkle"
                        app:tint="@color/pc_brand_deep_blue" />
                </LinearLayout>

                <TextView
                    android:id="@+id/profile_activity_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/fredoka_semibold"
                    android:maxLines="2"
                    android:text="No recorded activity yet"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/profile_member_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="PropCycle member"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_rating"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="SELLER RATING"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="10sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_welcome_sparkle"
                        app:tint="@color/pc_rating_gold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_rating_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RatingBar
                        android:id="@+id/profile_rating_bar"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:rating="0"
                        android:stepSize="0.1" />

                    <TextView
                        android:id="@+id/profile_rating_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="No marketplace ratings yet"
                        android:textColor="@color/pc_brand_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/profile_listings_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="MY LISTINGS"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/item_card"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_listing"
            android:clickable="true"
            android:contentDescription="Open my active marketplace listing"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_profile_listing_icon"
                android:contentDescription="@null"
                android:padding="14dp"
                android:src="@drawable/ic_material_box"
                app:tint="@color/pc_brand_deep_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_listing_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/fredoka_semibold"
                    android:maxLines="2"
                    android:text="No active marketplace listings"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/profile_listing_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"
                    android:text="Tap to create one"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lending_map_chevron_right"
                app:tint="@color/pc_brand_deep_blue" />
        </LinearLayout>

        <TextView
            android:id="@+id/profile_account_section_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="@string/profile_account_section"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/profile_account_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_account"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <LinearLayout
                android:id="@+id/change_password_action"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:clickable="true"
                android:contentDescription="Change password"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_settings_icon_blue"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_login_lock"
                    app:tint="@color/pc_brand_deep_blue" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/fredoka_semibold"
                    android:text="@string/profile_change_password"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lending_map_chevron_right"
                    app:tint="@color/pc_brand_deep_blue" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="60dp"
                android:background="@color/pc_brand_outline" />

            <LinearLayout
                android:id="@+id/logout_action"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:clickable="true"
                android:contentDescription="Log out"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_settings_icon_blue"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_profile_logout"
                    app:tint="@color/pc_brand_deep_blue" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/fredoka_semibold"
                    android:text="@string/profile_logout"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lending_map_chevron_right"
                    app:tint="@color/pc_brand_deep_blue" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="60dp"
                android:background="@color/pc_brand_outline" />

            <LinearLayout
                android:id="@+id/delete_account_action"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:clickable="true"
                android:contentDescription="Delete account"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_profile_danger_icon"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_lend_delete"
                    app:tint="@color/pc_brand_accent_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/fredoka_semibold"
                    android:text="@string/profile_delete_account"
                    android:textColor="@color/pc_brand_accent_red"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lending_map_chevron_right"
                    app:tint="@color/pc_brand_accent_red" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
