<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingTop="58dp"
    android:paddingEnd="@dimen/screen_horizontal"
    android:paddingBottom="@dimen/screen_vertical">

    <TextView
        android:id="@+id/hello_bubble"
        style="@style/TextAppearance.PropCycle.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:paddingStart="18dp"
        android:paddingTop="11dp"
        android:paddingEnd="18dp"
        android:paddingBottom="11dp"
        android:text="Hello!"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/identification_bubble"
        android:layout_width="245dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_light"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="13dp"
        android:paddingEnd="18dp"
        android:paddingBottom="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hello_bubble">

        <TextView
            style="@style/TextAppearance.PropCycle.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Identification"
            android:textColor="@color/pc_ink" />

        <TextView
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="PET Plastic Bottle"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.PropCycle.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="view details"
            android:textColor="@color/pc_ink"
            android:textStyle="italic" />
    </LinearLayout>

    <TextView
        android:id="@+id/mascot"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginTop="74dp"
        android:contentDescription="PropCycle cat mascot"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="( = ^ . ^ = )"
        android:textColor="@color/pc_ink"
        android:textSize="17sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/identification_bubble" />

    <TextView
        android:id="@+id/next_step_bubble"
        style="@style/TextAppearance.PropCycle.Body"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:background="@drawable/bg_card_light"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp"
        android:text="Please select the next step!"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/mascot"
        app:layout_constraintTop_toBottomOf="@id/identification_bubble" />

    <TextView
        android:id="@+id/recycle_action"
        style="@style/TextAppearance.PropCycle.Body"
        android:layout_width="200dp"
        android:layout_height="@dimen/touch_target"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:contentDescription="Recycle this item now"
        android:focusable="true"
        android:gravity="center"
        android:text="Recycle Now   •"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mascot" />

    <TextView
        android:id="@+id/sell_action"
        style="@style/TextAppearance.PropCycle.Body"
        android:layout_width="200dp"
        android:layout_height="@dimen/touch_target"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:contentDescription="Create a marketplace listing"
        android:focusable="true"
        android:gravity="center"
        android:text="Sell Item"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recycle_action" />

    <TextView
        android:id="@+id/lend_action"
        style="@style/TextAppearance.PropCycle.Body"
        android:layout_width="200dp"
        android:layout_height="@dimen/touch_target"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:contentDescription="List this item for lending"
        android:focusable="true"
        android:gravity="center"
        android:text="Lend Out"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sell_action" />

</androidx.constraintlayout.widget.ConstraintLayout>
