<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream">

    <ImageView
        android:layout_width="54dp"
        android:layout_height="34dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="-14dp"
        android:layout_marginTop="118dp"
        android:alpha="0.28"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_recent_squiggle" />

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="18dp"
        android:alpha="0.56"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_scanner_sparkle_red" />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="54dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="286dp"
        android:layout_marginEnd="-4dp"
        android:alpha="0.18"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_bottle" />

    <ImageView
        android:layout_width="62dp"
        android:layout_height="46dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="-16dp"
        android:layout_marginBottom="82dp"
        android:alpha="0.16"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_fabric_roll" />

    <ImageView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="-10dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.14"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_material_box" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">


            <LinearLayout
                android:id="@+id/identification_bubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_ai_result_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:outlineProvider="background"
                android:paddingStart="14dp"
                android:paddingTop="13dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/bg_home_icon_green"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="38dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_material_fabric_roll" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/result_heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka_semibold"
                            android:text="@string/ai_result_heading"
                            android:textColor="@color/pc_brand_deep_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/result_item_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/fredoka_semibold"
                            android:maxLines="2"
                            android:text="@string/ai_result_waiting_item"
                            android:textColor="@color/pc_brand_deep_blue"
                            android:textSize="23sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="3dp"
                    android:background="@color/pc_brand_outline"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/result_material"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/ai_result_material_placeholder"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/result_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/ai_result_category_placeholder"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/result_route"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/ai_result_route_placeholder"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/result_confidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ai_result_confidence_placeholder"
                    android:textColor="@color/pc_brand_eco_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:accessibilityLiveRegion="polite"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="3"
                    android:text="@string/ai_result_initial_status"
                    android:textColor="@color/pc_brand_text_secondary"
                    android:textSize="12sp" />


            </LinearLayout>

            <TextView
                android:id="@+id/result_disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_ai_result_page_warning"
                android:drawableStart="@drawable/ic_eco_bulb"
                android:drawablePadding="11dp"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:lineSpacingExtra="1dp"
                android:minHeight="64dp"
                android:outlineProvider="background"
                android:padding="12dp"
                android:text="@string/ai_result_disclaimer"
                android:textColor="@color/pc_brand_text_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/next_step_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ai_result_prompt_bubble"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingTop="7dp"
                android:paddingEnd="9dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_recent_sparkle" />

                <TextView
                    android:id="@+id/next_step_bubble"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/ai_result_next_step"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_scanner_rays_yellow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/result_guidance_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ai_result_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:outlineProvider="background"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_home_icon_sage"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_material_box" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/fredoka_semibold"
                        android:text="@string/ai_result_guidance_heading"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="2dp"
                    android:background="@color/pc_brand_outline"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/result_guidance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="5"
                    android:text="@string/ai_result_waiting_guidance"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/result_details_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_ai_result_chevron"
                    android:drawablePadding="4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="@dimen/touch_target"
                    android:minHeight="@dimen/touch_target"
                    android:paddingStart="8dp"
                    android:paddingEnd="2dp"
                    android:text="@string/ai_result_view_details"
                    android:textColor="@color/pc_brand_primary_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/result_actions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recycle_action"
                    android:layout_width="@dimen/ai_result_compact_action_width"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:background="@drawable/bg_ai_result_action"
                    android:clickable="true"
                    android:contentDescription="@string/ai_result_recycle_description"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/pc_on_primary"
                    android:enabled="false"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/ai_result_recycle"
                    android:textColor="@color/pc_on_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sell_action"
                    android:layout_width="@dimen/ai_result_compact_action_width"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.5"
                    android:background="@drawable/bg_ai_result_action_yellow"
                    android:clickable="true"
                    android:contentDescription="@string/ai_result_sell_description"
                    android:drawableStart="@drawable/ic_bottom_nav_marketplace"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/pc_brand_deep_blue"
                    android:enabled="false"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/ai_result_sell"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lend_action"
                    android:layout_width="@dimen/ai_result_compact_action_width"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.5"
                    android:background="@drawable/bg_ai_result_action_soft_blue"
                    android:clickable="true"
                    android:contentDescription="@string/ai_result_lend_description"
                    android:drawableStart="@drawable/ic_bottom_nav_lend_out"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/pc_brand_deep_blue"
                    android:enabled="false"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/ai_result_lend"
                    android:textColor="@color/pc_brand_deep_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scan_again_action"
                    style="@style/Widget.PropCycle.Button.Light"
                    android:layout_width="@dimen/ai_result_compact_action_width"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="52dp"
                    android:text="@string/ai_result_scan_again"
                    android:textColor="@color/pc_brand_deep_blue"
                    app:backgroundTint="@color/pc_brand_surface"
                    app:cornerRadius="@dimen/pill_corner"
                    app:icon="@drawable/ic_scanner_status_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@color/pc_brand_deep_blue"
                    app:strokeColor="@color/pc_brand_primary_blue"
                    app:strokeWidth="@dimen/stroke_thin" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
