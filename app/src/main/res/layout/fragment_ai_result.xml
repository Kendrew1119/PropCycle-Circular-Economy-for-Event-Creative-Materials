<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="40dp"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/hello_bubble"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:background="@drawable/bg_pill"
            android:paddingStart="18dp"
            android:paddingTop="11dp"
            android:paddingEnd="18dp"
            android:paddingBottom="11dp"
            android:text="@string/ai_result_hello"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/identification_bubble"
            android:layout_width="245dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_light"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="13dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/result_heading"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_result_heading"
                android:textColor="@color/pc_ink" />

            <TextView
                android:id="@+id/result_item_name"
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ai_result_waiting_item"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result_material"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/ai_result_material_placeholder"
                android:textColor="@color/pc_ink" />

            <TextView
                android:id="@+id/result_category"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ai_result_category_placeholder"
                android:textColor="@color/pc_ink" />

            <TextView
                android:id="@+id/result_route"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ai_result_route_placeholder"
                android:textColor="@color/pc_ink" />

            <TextView
                android:id="@+id/result_confidence"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ai_result_confidence_placeholder"
                android:textColor="@color/pc_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result_details_action"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minWidth="@dimen/touch_target"
                android:text="@string/ai_result_view_details"
                android:textColor="@color/pc_primary"
                android:textStyle="italic" />

        </LinearLayout>

        <TextView
            android:id="@+id/result_status"
            style="@style/TextAppearance.PropCycle.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:text="@string/ai_result_initial_status"
            android:textAlignment="center"
            android:textColor="@color/pc_text_secondary" />

        <TextView
            android:id="@+id/result_disclaimer"
            style="@style/TextAppearance.PropCycle.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_scanner_disclosure"
            android:lineSpacingExtra="2dp"
            android:padding="13dp"
            android:text="@string/ai_result_disclaimer"
            android:textColor="@color/pc_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mascot"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:contentDescription="@string/ai_result_mascot_description"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/ai_result_mascot"
                android:textColor="@color/pc_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/next_step_bubble"
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_light"
                android:gravity="center"
                android:minHeight="84dp"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="@string/ai_result_next_step"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/result_guidance_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_light"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.PropCycle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_result_guidance_heading"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result_guidance"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/ai_result_waiting_guidance"
                android:textColor="@color/pc_text_primary" />

        </LinearLayout>

        <TextView
            android:id="@+id/recycle_action"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="200dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="22dp"
            android:alpha="0.5"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:contentDescription="@string/ai_result_recycle_description"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/ai_result_recycle"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sell_action"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="200dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="10dp"
            android:alpha="0.5"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:contentDescription="@string/ai_result_sell_description"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/ai_result_sell"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lend_action"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="200dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="10dp"
            android:alpha="0.5"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:contentDescription="@string/ai_result_lend_description"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/ai_result_lend"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scan_again_action"
            style="@style/Widget.PropCycle.Button.Light"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/ai_result_scan_again" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
