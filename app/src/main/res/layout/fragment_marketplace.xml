<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="120dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:text="Marketplace"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="35sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Find materials ready for their next event."
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="132dp"
            android:layout_height="102dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/pc_sticker_marketplace_box" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_marketplace_search">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="18dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_marketplace_search" />

        <EditText
            android:id="@+id/market_search_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:hint="Search materials"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="58dp"
            android:paddingEnd="18dp"
            android:textColor="@color/pc_brand_text_primary"
            android:textColorHint="@color/pc_brand_text_secondary"
            android:textSize="17sp" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filter_all_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_marketplace_filter_selected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:minWidth="54dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="All"
                android:textColor="@color/pc_white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/filter_decoration_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_marketplace_filter"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Decoration"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/filter_fabric_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_marketplace_filter"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Fabric"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/filter_wood_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_marketplace_filter"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Wood"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/filter_more_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_marketplace_filter"
                android:clickable="true"
                android:contentDescription="Choose another marketplace category"
                android:focusable="true"
                android:fontFamily="@font/fredoka_semibold"
                android:gravity="center"
                android:minWidth="60dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="More"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/marketplace_create_action"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="+  List an item"
        android:textAllCaps="false"
        android:textColor="@color/pc_brand_surface"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/pc_brand_primary_blue"
        app:cornerRadius="20dp" />

    <TextView
        android:id="@+id/marketplace_cache_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="Offline cache - results may be outdated."
        android:textColor="@color/pc_brand_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/marketplace_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:scrollbars="vertical"
            tools:itemCount="4"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_marketplace_listing"
            tools:spanCount="2" />

        <ProgressBar
            android:id="@+id/marketplace_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/pc_brand_primary_blue"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/marketplace_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="17sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
