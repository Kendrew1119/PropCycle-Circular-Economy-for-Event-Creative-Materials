<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_brand_warm_cream"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="78dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="82dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_semibold"
                android:includeFontPadding="false"
                android:text="Marketplace"
                android:textColor="@color/pc_brand_deep_blue"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Find materials ready for their next event."
                android:textColor="@color/pc_brand_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/pc_sticker_marketplace_stars" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="@color/pc_brand_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/pc_brand_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_marketplace_search">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_marketplace_search" />

                <EditText
                    android:id="@+id/market_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Search materials"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="46dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/pc_brand_text_primary"
                    android:textColorHint="@color/pc_brand_text_secondary"
                    android:textSize="14sp" />
            </FrameLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filter_all_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_marketplace_filter_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:minWidth="54dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="All"
                        android:textColor="@color/pc_brand_surface"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_decoration_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Decoration"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_fabric_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Fabric"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_wood_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Wood"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_banner_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:minWidth="60dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Banner"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_stationery_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Stationery"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_craft_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Craft"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_cosplay_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Cosplay"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_toys_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Toys"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_electronic_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Electronic"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_packaging_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Packaging"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/filter_other_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_marketplace_filter"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Other"
                        android:textColor="@color/pc_brand_deep_blue"
                        android:textSize="14sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/marketplace_create_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/fredoka_semibold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="+  List an item"
                android:textAllCaps="false"
                android:textColor="@color/pc_brand_surface"
                android:textSize="17sp"
                app:backgroundTint="@color/pc_brand_primary_blue"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/marketplace_cache_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:text="Offline cache - results may be outdated."
        android:textColor="@color/pc_brand_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/fredoka_semibold"
            android:text="Fresh from the community"
            android:textColor="@color/pc_brand_deep_blue"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/marketplace_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_semibold"
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/marketplace_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:scrollbars="vertical"
            tools:itemCount="4"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_marketplace_listing"
            tools:spanCount="2" />

        <ProgressBar
            android:id="@+id/marketplace_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/pc_brand_primary_blue"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/marketplace_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/pc_brand_text_secondary"
            android:textSize="17sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
