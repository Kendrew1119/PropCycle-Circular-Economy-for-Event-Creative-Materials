<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal"
    android:paddingTop="@dimen/screen_vertical"
    android:paddingEnd="@dimen/screen_horizontal">


    <EditText
        android:id="@+id/market_search_input"
        style="@style/TextAppearance.PropCycle.Body"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target"
        android:background="@color/pc_transparent"
        android:hint="Search..."
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:textColor="@color/pc_ink"
        android:textColorHint="@color/pc_text_secondary"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:gravity="center_vertical"
        android:letterSpacing="0.16"
        android:maxLines="1"
        android:text="- - - - - - - - - - - - - - - - - -"
        android:textColor="@color/pc_ink"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filter_all_action"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="58dp"
                android:layout_height="@dimen/touch_target"
                android:background="@drawable/bg_pill_dark"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="All"
                android:textColor="@color/pc_white" />

            <TextView
                android:id="@+id/filter_decoration_action"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="98dp"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Decoration" />

            <TextView
                android:id="@+id/filter_fabric_action"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="72dp"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Fabric" />

            <TextView
                android:id="@+id/filter_wood_action"
                style="@style/TextAppearance.PropCycle.Caption"
                android:layout_width="68dp"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Wood" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/marketplace_cache_status"
        style="@style/TextAppearance.PropCycle.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="Offline cache - results may be outdated."
        android:textColor="@color/pc_text_secondary"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/marketplace_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/marketplace_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/marketplace_status"
            style="@style/TextAppearance.PropCycle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/pc_text_secondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
