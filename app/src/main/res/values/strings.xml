    <string name="settings_help_intro">Quick answers about the PropCycle features available today.</string>
    <string name="settings_help_marketplace_question">How do I list a Marketplace item?</string>
    <string name="settings_help_marketplace_answer">Open Marketplace or Create Listing, add the real item details and optional photo, then publish. Owners can edit, withdraw, or relist their own listing.</string>
    <string name="settings_help_lending_question">How does lending work?</string>
    <string name="settings_help_lending_answer">Use Lend Resource to publish an available item. A borrower can request dates; the owner approves or rejects the request, and both users track pickup and return in the existing lending flow.</string>
    <string name="settings_help_scanner_question">What does AI Smart Scanner do?</string>
    <string name="settings_help_scanner_answer">It analyzes a photo and suggests an item, material, category, safety guidance, and reuse route. Results are estimates that you must review; a scan never publishes a listing automatically.</string>
    <string name="settings_help_recycle_question">How do I find a recycle centre?</string>
    <string name="settings_help_recycle_answer">Search a city or area in Recycle Center, or choose Use location after granting foreground location permission. Confirm accepted materials with the centre before travelling.</string>
    <string name="settings_help_map_question">What is Lending Map?</string>
    <string name="settings_help_map_answer">It shows available lending items that have an owner-provided approximate map point. The lending list, search, and filters still work when the in-app map is not configured.</string>
    <string name="settings_help_messages_question">How does Messaging work?</string>
    <string name="settings_help_messages_answer">Marketplace and lending participants can use existing in-app conversations. Chatting does not mark an item sold or complete a lending request.</string>
    <string name="settings_help_location_question">Why does PropCycle ask for location?</string>
    <string name="settings_help_location_answer">Location is optional and used only after you request nearby recycling centres, nearby lending sorting, or attach an approximate lending area. Manual search remains available.</string>

    <string name="settings_privacy_intro">A plain-language summary of how the current PropCycle features use information.</string>
    <string name="settings_privacy_account_title">Account and profile</string>
    <string name="settings_privacy_account_body">Your email and authentication credentials are handled by Firebase Authentication. PropCycle profile data includes your display name and selected avatar.</string>
    <string name="settings_privacy_location_title">Location</string>
    <string name="settings_privacy_location_body">The app requests foreground coarse and fine location together only for location-based actions. Approximate location is supported; current precise coordinates are not continuously tracked or uploaded. An owner may deliberately publish an approximate lending point and area label.</string>
    <string name="settings_privacy_search_title">Recent searches</string>
    <string name="settings_privacy_search_body">Home search is processed while the screen is active. This version does not save recent-search history on the device.</string>
    <string name="settings_privacy_messages_title">Listings and messages</string>
    <string name="settings_privacy_messages_body">Marketplace listings, lending records, requests, and participant chat messages are stored in Firebase so signed-in users can use the implemented sharing flows.</string>
    <string name="settings_privacy_scanner_title">AI Scanner estimates</string>
    <string name="settings_privacy_scanner_body">A selected image is analyzed through Firebase AI Logic to produce estimates and guidance. Results may be incomplete or incorrect and must be reviewed before reuse, lending, listing, or recycling decisions.</string>
    <string name="settings_privacy_local_title">Local activity</string>
    <string name="settings_privacy_local_body">Scan and activity history is stored locally for the signed-in account on this device. Clearing local activity does not delete Firebase listings, lending records, or chats.</string>

    <string name="settings_about_intro">PropCycle helps communities keep event and creative materials in use for longer.</string>
    <string name="settings_about_sharing_title">Circular sharing</string>
    <string name="settings_about_sharing_body">Marketplace helps users list reusable materials, while Lending supports temporary sharing and return tracking.</string>
    <string name="settings_about_decisions_title">Smarter decisions</string>
    <string name="settings_about_decisions_body">AI Smart Scanner offers item and material estimates, and Recycle Center helps users search for nearby recycling organisations.</string>
    <string name="settings_about_community_title">Connected community</string>
    <string name="settings_about_community_body">Lending Map helps users discover available items with approximate locations, and Messaging keeps participants in contact.</string>
    <string name="settings_about_scope_title">Current scope</string>
    <string name="settings_about_scope_body">PropCycle supports these in-app tools without promising payments, turn-by-turn routes, or automatic recycling acceptance.</string>
</resources>
