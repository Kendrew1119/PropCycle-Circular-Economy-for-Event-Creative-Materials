<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.PropCycle.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textColor">@color/pc_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.PropCycle.Heading" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textColor">@color/pc_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.PropCycle.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textColor">@color/pc_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.PropCycle.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/pc_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.PropCycle.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/pc_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.PropCycle.SettingsInfoTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textColor">@color/pc_brand_deep_blue</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.PropCycle.SettingsInfoBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/pc_brand_text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.PropCycle.BottomNavigation" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.PropCycle.BottomNavigation.Active" parent="TextAppearance.PropCycle.BottomNavigation">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.PropCycle.BottomNavigation.ActiveIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.PropCycle.BottomNavigation.ActiveIndicator" parent="">
        <item name="android:width">@dimen/bottom_navigation_active_indicator_size</item>
        <item name="android:height">@dimen/bottom_navigation_active_indicator_size</item>
        <item name="android:color">@color/pc_brand_accent_yellow</item>
        <item name="marginHorizontal">@dimen/bottom_navigation_active_indicator_margin</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PropCycle.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="Widget.PropCycle.Button.Dark" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/pc_primary</item>
        <item name="android:textColor">@color/pc_on_primary</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.PropCycle.Button.Light" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/pc_primary_container</item>
        <item name="android:textColor">@color/pc_on_primary_container</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PropCycle.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_circle_white</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/pc_icon</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="Widget.PropCycle.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/pc_text_primary</item>
        <item name="android:textColorHint">@color/pc_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.PropCycle.DropdownField" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:background">@drawable/bg_propcycle_dropdown_field</item>
        <item name="android:foreground">@drawable/fg_propcycle_dropdown_outline</item>
        <item name="android:minHeight">48dp</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/pc_brand_surface</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxStrokeColor">@color/pc_brand_primary_blue</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="endIconDrawable">@drawable/ic_lending_map_chevron_down</item>
        <item name="endIconTint">@color/pc_brand_deep_blue</item>
        <item name="hintTextColor">@color/pc_brand_text_secondary</item>
    </style>

    <style name="Widget.PropCycle.DropdownInput" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:inputType">none</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:popupBackground">@drawable/bg_propcycle_dropdown_popup</item>
        <item name="android:textColor">@color/pc_brand_deep_blue</item>
        <item name="android:textColorHint">@color/pc_brand_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.PropCycle.CreateListing.Field" parent="Widget.PropCycle.Field">
        <item name="android:background">@drawable/bg_create_listing_field</item>
        <item name="android:gravity">bottom|start</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.PropCycle.CreateListing.Description" parent="Widget.PropCycle.CreateListing.Field">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/create_listing_description_height</item>
        <item name="android:background">@drawable/bg_create_listing_description</item>
        <item name="android:gravity">top|start</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/ai_result_section_spacing</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/ai_result_section_spacing</item>
    </style>

    <style name="ThemeOverlay.PropCycle.MaterialDatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/pc_brand_primary_blue</item>
        <item name="colorOnPrimary">@color/pc_brand_surface</item>
        <item name="colorSurface">@color/pc_brand_surface</item>
        <item name="colorOnSurface">@color/pc_brand_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/pc_brand_deep_blue</item>
        <item name="colorOutline">@color/pc_brand_outline</item>
        <item name="materialCalendarStyle">@style/Widget.PropCycle.MaterialCalendar</item>
        <item name="materialCalendarHeaderTitle">@style/Widget.PropCycle.MaterialCalendar.HeaderTitle</item>
        <item name="materialCalendarHeaderSelection">@style/Widget.PropCycle.MaterialCalendar.HeaderSelection</item>
        <item name="materialCalendarDayOfWeekLabel">@style/Widget.PropCycle.MaterialCalendar.DayOfWeekLabel</item>
        <item name="materialCalendarDay">@style/Widget.PropCycle.MaterialCalendar.DayTextView</item>
        <item name="materialCalendarMonth">@style/Widget.PropCycle.MaterialCalendar.MonthTextView</item>
        <item name="materialCalendarHeaderConfirmButton">@style/Widget.PropCycle.MaterialCalendar.ActionButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PropCycle.MaterialCalendar.ActionButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PropCycle.MaterialCalendar.ActionButton</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar" parent="Widget.Material3.MaterialCalendar">
        <item name="backgroundTint">@color/pc_brand_surface</item>
        <item name="dayStyle">@style/Widget.PropCycle.MaterialCalendar.Day</item>
        <item name="dayInvalidStyle">@style/Widget.PropCycle.MaterialCalendar.Day.Invalid</item>
        <item name="daySelectedStyle">@style/Widget.PropCycle.MaterialCalendar.Day.Selected</item>
        <item name="dayTodayStyle">@style/Widget.PropCycle.MaterialCalendar.Day.Today</item>
        <item name="yearStyle">@style/Widget.PropCycle.MaterialCalendar.Year</item>
        <item name="yearSelectedStyle">@style/Widget.PropCycle.MaterialCalendar.Year.Selected</item>
        <item name="yearTodayStyle">@style/Widget.PropCycle.MaterialCalendar.Year.Today</item>
        <item name="rangeFillColor">@color/pc_brand_soft_blue</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.Day" parent="Widget.Material3.MaterialCalendar.Day">
        <item name="itemTextColor">@color/pc_brand_text_primary</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.Day.Invalid" parent="Widget.Material3.MaterialCalendar.Day.Invalid">
        <item name="itemTextColor">@color/pc_brand_outline</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.Day.Selected" parent="Widget.Material3.MaterialCalendar.Day.Selected">
        <item name="itemFillColor">@color/pc_brand_primary_blue</item>
        <item name="itemTextColor">@color/pc_brand_surface</item>
        <item name="itemStrokeColor">@color/pc_brand_deep_blue</item>
        <item name="itemStrokeWidth">1dp</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.Day.Today" parent="Widget.Material3.MaterialCalendar.Day.Today">
        <item name="itemTextColor">@color/pc_brand_deep_blue</item>
        <item name="itemStrokeColor">@color/pc_brand_deep_blue</item>
        <item name="itemStrokeWidth">1dp</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.Year" parent="Widget.Material3.MaterialCalendar.Year">
        <item name="itemTextColor">@color/pc_brand_text_primary</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.Year.Selected" parent="Widget.Material3.MaterialCalendar.Year.Selected">
        <item name="itemFillColor">@color/pc_brand_primary_blue</item>
        <item name="itemTextColor">@color/pc_brand_surface</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.Year.Today" parent="Widget.Material3.MaterialCalendar.Year.Today">
        <item name="itemTextColor">@color/pc_brand_deep_blue</item>
        <item name="itemStrokeColor">@color/pc_brand_deep_blue</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.HeaderTitle" parent="Widget.Material3.MaterialCalendar.HeaderTitle">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textColor">@color/pc_brand_deep_blue</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.HeaderSelection" parent="Widget.Material3.MaterialCalendar.HeaderSelection">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textColor">@color/pc_brand_deep_blue</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.DayOfWeekLabel" parent="Widget.Material3.MaterialCalendar.DayOfWeekLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pc_brand_deep_blue</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.DayTextView" parent="Widget.Material3.MaterialCalendar.DayTextView">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.MonthTextView" parent="Widget.Material3.MaterialCalendar.MonthTextView">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textColor">@color/pc_brand_deep_blue</item>
    </style>

    <style name="Widget.PropCycle.MaterialCalendar.ActionButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pc_brand_primary_blue</item>
    </style>

    <style name="TextAppearance.PropCycle.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textColor">@color/pc_brand_deep_blue</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ThemeOverlay.PropCycle.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/pc_brand_primary_blue</item>
        <item name="colorSurface">@color/pc_brand_surface</item>
        <item name="colorOnSurface">@color/pc_brand_text_primary</item>
        <item name="colorOutline">@color/pc_brand_outline</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.PropCycle.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PropCycle.DialogButton.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PropCycle.DialogButton.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.PropCycle.DialogButton.Secondary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.PropCycle.Dialog</item>
    </style>

    <style name="Widget.PropCycle.DialogButton.Primary" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pc_brand_primary_blue</item>
    </style>

    <style name="Widget.PropCycle.DialogButton.Secondary" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pc_brand_deep_blue</item>
    </style>

    <style name="Widget.PropCycle.DialogField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/pc_brand_surface</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxStrokeColor">@color/pc_brand_primary_blue</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/pc_brand_text_secondary</item>
        <item name="startIconTint">@color/pc_brand_deep_blue</item>
    </style>

    <style name="ShapeAppearance.PropCycle.Dialog" parent="">
        <item name="cornerSize">24dp</item>
        <item name="cornerFamily">rounded</item>
    </style>
</resources>
