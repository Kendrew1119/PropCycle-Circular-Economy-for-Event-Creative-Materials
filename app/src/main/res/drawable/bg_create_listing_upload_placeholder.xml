<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_brand_warm_cream" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <bitmap
            android:antialias="true"
            android:gravity="fill"
            android:src="@drawable/create_listing_upload_fabric" />
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/pc_brand_primary_blue"
                android:dashGap="7dp"
                android:dashWidth="9dp" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
