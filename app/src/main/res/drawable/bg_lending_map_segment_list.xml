<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_brand_soft_blue" />
            <corners android:topRightRadius="23dp" android:bottomRightRadius="23dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_transparent" />
            <corners android:topRightRadius="23dp" android:bottomRightRadius="23dp" />
        </shape>
    </item>
</selector>
